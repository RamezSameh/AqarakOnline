@model ContactMessage
<div class="auth-card">
<h1>@L.T("ContactUs")</h1>
<p>عندك سؤال أو استفسار؟ ابعت رسالتك وهنرد عليك.</p>
<div class="contact-info">
    <a class="btn btn-primary contact-big-btn" href="tel:@ContactOptions.Value.Phone">📞 @L.T("CallUs")</a>
    <a class="btn btn-primary contact-big-btn" href="https://wa.me/@ContactOptions.Value.WhatsAppDigits" target="_blank" rel="noopener">💬 @L.T("WhatsApp")</a>
    <a class="btn btn-ghost contact-big-btn" href="mailto:@ContactOptions.Value.Email">✉️ @L.T("Email")</a>
</div>
<form asp-action="Contact" method="post" class="form">
    <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
    <label>@L.T("YourName")</label>
    <input asp-for="Name" />
    <span asp-validation-for="Name" class="field-error"></span>
    <label>@L.T("YourPhone")</label>
    <input asp-for="Phone" />
    <span asp-validation-for="Phone" class="field-error"></span>
    <label>@L.T("YourMessage")</label>
    <textarea asp-for="Message" rows="5"></textarea>
    <span asp-validation-for="Message" class="field-error"></span>
    <div class="actions">
        <button type="submit" class="btn btn-primary">@L.T("SendMessage")</button>
    </div>
</form>
</div>
