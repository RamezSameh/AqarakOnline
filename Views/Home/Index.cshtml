@model IEnumerable<Listing>
<section class="hero">
    <h1>@L.T("Brand")</h1>
    <p class="hero-tagline">@L.T("Tagline")</p>
    <form class="hero-search" asp-controller="Listings" asp-action="Index" method="get">
        <input type="text" name="search" placeholder="@L.T("SearchPlaceholder")" />
        <button type="submit" class="btn btn-primary">@L.T("Search")</button>
    </form>
    <div class="hero-actions">
        <a class="btn btn-primary" asp-controller="Listings" asp-action="Index">تصفح الإعلانات</a>
        <a class="btn btn-ghost" asp-controller="Listings" asp-action="Create">@L.T("CreateListing")</a>
    </div>
</section>

<section class="home-stats">
    <div class="stat"><strong class="count-up">@ViewBag.AvailableListingsCount</strong><span>@L.T("StatsAvailableListings")</span></div>
    <div class="stat"><strong class="count-up">@ViewBag.AreasCount</strong><span>@L.T("StatsAreas")</span></div>
</section>

<section class="about">
    <h2>@L.T("AboutUs")</h2>
    <p>@L.T("AboutText")</p>
    <h2>@L.T("WhyChooseUs")</h2>
    <div class="why-grid">
        <div class="why-card">
            <h3>⚡ @L.T("WhyFastTitle")</h3>
            <p>@L.T("WhyFastText")</p>
        </div>
        <div class="why-card">
            <h3>👁️ @L.T("WhyFollowTitle")</h3>
            <p>@L.T("WhyFollowText")</p>
        </div>
        <div class="why-card">
            <h3>💰 @L.T("WhyCommissionTitle")</h3>
            <p>@L.T("WhyCommissionText")</p>
        </div>
        <div class="why-card">
            <h3>🤝 @L.T("WhyNoExploitationTitle")</h3>
            <p>@L.T("WhyNoExploitationText")</p>
        </div>
    </div>
</section>

@if (ViewBag.FeaturedListings != null && ((List<Listing>)ViewBag.FeaturedListings).Any())
{
    <section>
        <div class="section-head">
            <h2>⭐ @L.T("Featured")</h2>
            <a class="btn btn-ghost" asp-controller="Listings" asp-action="Index">@L.T("SeeAll")</a>
        </div>
        <div class="cards-slider">
            @foreach (var listing in (List<Listing>)ViewBag.FeaturedListings)
            {
                @await Html.PartialAsync("_ListingCard", listing)
            }
        </div>
    </section>
}

<section>
    <div class="section-head">
        <h2>@L.T("LatestListings")</h2>
        <a class="btn btn-ghost" asp-controller="Listings" asp-action="Index">@L.T("SeeAll")</a>
    </div>
    <div class="cards-slider">
        @foreach (var listing in Model)
        {
            @await Html.PartialAsync("_ListingCard", listing)
        }
    </div>
</section>

@if (ViewBag.MostViewed != null && ((List<Listing>)ViewBag.MostViewed).Any())
{
    <section>
        <div class="section-head">
            <h2>@L.T("MostViewed")</h2>
            <a class="btn btn-ghost" asp-controller="Listings" asp-action="Index" asp-route-sort="viewsDesc">@L.T("SeeAll")</a>
        </div>
        <div class="cards-grid">
            @foreach (var listing in (List<Listing>)ViewBag.MostViewed)
            {
                @await Html.PartialAsync("_ListingCard", listing)
            }
        </div>
    </section>
}

@if (ViewBag.PopularAreas != null && ((List<AqarakOnline.Controllers.ChartPoint>)ViewBag.PopularAreas).Any())
{
    <section>
        <div class="section-head">
            <h2>@L.T("PopularAreas")</h2>
        </div>
        <div class="area-chips">
            @foreach (var area in (List<AqarakOnline.Controllers.ChartPoint>)ViewBag.PopularAreas)
            {
                <a class="btn btn-ghost" href="/Listings/Area/@Uri.EscapeDataString(area.Label)">@area.Label (@area.Count)</a>
            }
        </div>
    </section>
}
