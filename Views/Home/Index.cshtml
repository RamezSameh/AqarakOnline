@model IEnumerable<Listing>
<section class="hero">
    <h1>@L.T("Brand")</h1>
    <p class="hero-tagline">@L.T("Tagline")</p>
    <form class="hero-search" asp-controller="Listings" asp-action="Index" method="get">
        <input type="text" name="search" placeholder="@L.T("SearchPlaceholder")" />
        <button type="submit" class="btn btn-primary">@L.T("Search")</button>
    </form>
</section>

<section class="about">
    <h2>@L.T("AboutUs")</h2>
    <p>@L.T("AboutText")</p>
    <h2>@L.T("WhyChooseUs")</h2>
    <div class="why-grid">
        <div class="why-card">
            <h3>@L.T("WhyFastTitle")</h3>
            <p>@L.T("WhyFastText")</p>
        </div>
        <div class="why-card">
            <h3>@L.T("WhyFollowTitle")</h3>
            <p>@L.T("WhyFollowText")</p>
        </div>
        <div class="why-card">
            <h3>@L.T("WhyCommissionTitle")</h3>
            <p>@L.T("WhyCommissionText")</p>
        </div>
        <div class="why-card">
            <h3>@L.T("WhyNoExploitationTitle")</h3>
            <p>@L.T("WhyNoExploitationText")</p>
        </div>
    </div>
</section>

<section>
    <div class="section-head">
        <h2>@L.T("LatestListings")</h2>
        <a class="btn btn-ghost" asp-controller="Listings" asp-action="Index">@L.T("SeeAll")</a>
    </div>
    <div class="cards-grid">
        @foreach (var listing in Model)
        {
            @await Html.PartialAsync("_ListingCard", listing)
        }
    </div>
</section>
