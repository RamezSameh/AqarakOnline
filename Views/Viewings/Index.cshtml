@model List<ViewingAppointment>
<h1>@L.T("Viewings")</h1>
<p><small>المعاينة بتتنسق عن طريق إدارة الموقع — لا يوجد تواصل مباشر مع المعلن.</small></p>
@if (!Model.Any())
{
    <p>@L.T("NoViewings")</p>
}
else
{
    <div class="viewings-list">
        @foreach (var viewing in Model)
        {
            <article class="viewing-card status-@viewing.Status">
                <h3><a asp-controller="Listings" asp-action="Details" asp-route-id="@viewing.ListingId">@viewing.Listing?.Title</a></h3>
                <p>@L.T("ViewingDate"): @viewing.RequestedAt.ToString("dd/MM/yyyy HH:mm")</p>
                <p><span class="viewing-status">@L.ViewingStatusText(viewing.Status)</span></p>
                @if (viewing.Status == ViewingStatus.Pending || viewing.Status == ViewingStatus.Confirmed)
                {
                    <form asp-action="Cancel" method="post" class="inline-form">
                        <input type="hidden" name="id" value="@viewing.Id" />
                        <button type="submit" class="btn btn-ghost">@L.T("Cancel")</button>
                    </form>
                }
            </article>
        }
    </div>
}
