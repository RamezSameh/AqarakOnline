@model List<ViewingAppointment>
<h1>@L.T("Viewings")</h1>
<p><small>المعاينة بتتنسق عن طريق إدارة الموقع — لا يوجد تواصل مباشر مع المعلن.</small></p>
@if (!Model.Any())
{
    <p>@L.T("NoViewings")</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>@L.T("Title")</th>
                <th>@L.T("ViewingDate")</th>
                <th>@L.T("ApprovalStatus")</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var viewing in Model)
            {
                <tr>
                    <td><a asp-controller="Listings" asp-action="Details" asp-route-id="@viewing.ListingId">@viewing.Listing?.Title</a></td>
                    <td>@viewing.RequestedAt.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@L.ViewingStatusText(viewing.Status)</td>
                    <td>
                        @if (viewing.Status == ViewingStatus.Pending || viewing.Status == ViewingStatus.Confirmed)
                        {
                            <form asp-action="Cancel" method="post" class="inline-form">
                                <input type="hidden" name="id" value="@viewing.Id" />
                                <button type="submit" class="btn btn-ghost">@L.T("Cancel")</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
