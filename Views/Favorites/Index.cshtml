@model IEnumerable<Listing>
@{
    var sortOptions = new List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>
    {
        new(L.T("SortNewest"), "newest", ViewBag.Sort == "newest"),
        new(L.T("SortPriceAsc"), "priceAsc", ViewBag.Sort == "priceAsc"),
        new(L.T("SortPriceDesc"), "priceDesc", ViewBag.Sort == "priceDesc")
    };
}
<h1>@L.T("Favorites")</h1>
@if (!Model.Any())
{
    <p>@L.T("NoFavorites")</p>
    <a class="btn btn-primary" asp-controller="Listings" asp-action="Index">@L.T("Listings")</a>
}
else
{
    <form class="filter-form" asp-controller="Favorites" asp-action="Index" method="get">
        <label class="sort-label">
            @L.T("SortBy")
            <select name="sort" asp-items="sortOptions"></select>
        </label>
        <button type="submit" class="btn btn-primary">@L.T("Filter")</button>
    </form>
    <div class="actions">
        @if (User.Identity?.IsAuthenticated == true)
        {
            <form asp-controller="Favorites" asp-action="ClearAll" method="post" class="inline-form" onsubmit="return confirm('حذف كل المفضلة؟');">
                <button type="submit" class="btn btn-ghost">@L.T("ClearAllFavorites")</button>
            </form>
        }
        else
        {
            <button type="button" class="btn btn-ghost clear-guest-favorites">@L.T("ClearAllFavorites")</button>
        }
    </div>
    <div class="cards-grid">
        @foreach (var listing in Model)
        {
            @await Html.PartialAsync("_ListingCard", listing)
        }
    </div>
}
