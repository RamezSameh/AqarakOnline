@model IEnumerable<Listing>
@{
    var sortOptions = new List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>
    {
        new(L.T("SortNewest"), "newest", ViewBag.Sort == "newest"),
        new(L.T("SortPriceAsc"), "priceAsc", ViewBag.Sort == "priceAsc"),
        new(L.T("SortPriceDesc"), "priceDesc", ViewBag.Sort == "priceDesc"),
        new(L.T("SortViewsDesc"), "viewsDesc", ViewBag.Sort == "viewsDesc"),
        new(L.T("SortAreaAsc"), "areaAsc", ViewBag.Sort == "areaAsc"),
        new(L.T("SortAreaDesc"), "areaDesc", ViewBag.Sort == "areaDesc")
    };
    var typeOptions = new List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>
    {
        new(L.T("All"), "", string.IsNullOrWhiteSpace(ViewBag.PropertyType))
    };
    foreach (PropertyType pt in Enum.GetValues(typeof(PropertyType)))
    {
        typeOptions.Add(new Microsoft.AspNetCore.Mvc.Rendering.SelectListItem(L.PropertyTypeText(pt), pt.ToString(), ViewBag.PropertyType == pt.ToString()));
    }
}
<h1>@L.T("Favorites") (@Model.Count())</h1>
@if (!Model.Any())
{
    <p>@L.T("NoFavorites")</p>
    <a class="btn btn-primary" asp-controller="Listings" asp-action="Index">@L.T("Listings")</a>
}
else
{
    <form class="filter-form" asp-controller="Favorites" asp-action="Index" method="get">
        <label class="sort-label sort-select-hidden">
            @L.T("SortBy")
            <select name="sort" id="favoritesSortSelect" asp-items="sortOptions"></select>
        </label>
        <div class="fav-sort-tabs">
            @foreach (var opt in sortOptions)
            {
                <button type="button" class="btn tab-chip @(ViewBag.Sort == opt.Value ? "active" : "")" data-sort="@opt.Value">@opt.Text</button>
            }
        </div>
        <label class="sort-label">
            @L.T("PropertyType")
            <select name="propertyType" asp-items="typeOptions"></select>
        </label>
        <input type="search" name="search" value="@ViewBag.Search" placeholder="@L.T("Search")" />
        <button type="submit" class="btn btn-primary">@L.T("Filter")</button>
    </form>
    <div class="actions">
        <button type="button" id="compareAllBtn" class="btn btn-primary">مقارنة الكل ⚖️</button>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <form asp-controller="Favorites" asp-action="ClearAll" method="post" class="inline-form" onsubmit="return confirm('حذف كل المفضلة؟');">
                <button type="submit" class="btn btn-ghost">@L.T("ClearAllFavorites")</button>
            </form>
        }
        else
        {
            <button type="button" class="btn btn-ghost clear-guest-favorites">@L.T("ClearAllFavorites")</button>
        }
    </div>
    <div class="cards-grid">
        @foreach (var listing in Model)
        {
            <div class="favorite-item">
                @await Html.PartialAsync("_ListingCard", listing)
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <form asp-controller="Favorites" asp-action="Toggle" method="post" class="inline-form">
                        <input type="hidden" name="listingId" value="@listing.Id" />
                        <input type="hidden" name="returnUrl" value="/Favorites" />
                        <button type="submit" class="btn btn-ghost favorite-remove">✕ إزالة من المفضلة</button>
                    </form>
                }
                else
                {
                    <button type="button" class="btn btn-ghost favorite-remove guest-favorite-remove" data-id="@listing.Id">✕ إزالة من المفضلة</button>
                }
            </div>
        }
    </div>
}
