@model IEnumerable<Listing>
@{
    var statusOptions = new List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>
    {
        new(L.T("StatusAll"), "all", ViewBag.Status == "all"),
        new(L.T("StatusAvailable"), "available", ViewBag.Status == "available"),
        new(L.T("StatusUnavailable"), "unavailable", ViewBag.Status == "unavailable"),
        new(L.T("StatusPending"), "pending", ViewBag.Status == "pending")
    };
    var sortOptions = new List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>
    {
        new(L.T("SortNewest"), "newest", ViewBag.Sort == "newest"),
        new(L.T("SortOldest"), "oldest", ViewBag.Sort == "oldest"),
        new(L.T("SortPriceAsc"), "priceAsc", ViewBag.Sort == "priceAsc"),
        new(L.T("SortPriceDesc"), "priceDesc", ViewBag.Sort == "priceDesc"),
        new(L.T("SortViewsDesc"), "viewsDesc", ViewBag.Sort == "viewsDesc")
    };
}
<h1>@L.T("MyListings")</h1>
<p class="my-listings-counts">مقبول: @Model.Count(l => l.Approval == ListingApproval.Approved) • معلّق: @Model.Count(l => l.Approval == ListingApproval.Pending) • مرفوض: @Model.Count(l => l.Approval == ListingApproval.Rejected)</p>
<form asp-action="BumpAll" method="post" class="inline-form" onsubmit="return confirm('تجديد كل إعلاناتك اللي عدى عليها 7 أيام؟');">
    <button type="submit" class="btn btn-primary">تجديد الكل 🔄</button>
</form>
<form class="filter-form" asp-action="MyListings" method="get">
    <label class="sort-label">
        @L.T("Status")
        <select name="status" asp-items="statusOptions"></select>
    </label>
    <input type="text" name="search" value="@ViewBag.Search" placeholder="@L.T("SearchPlaceholder")" />
    <label class="sort-label">
        @L.T("SortBy")
        <select name="sort" asp-items="sortOptions"></select>
    </label>
    <button type="submit" class="btn btn-primary">@L.T("Filter")</button>
    <a class="btn btn-ghost" asp-action="MyListings">@L.T("ClearFilter")</a>
</form>
@if (!Model.Any())
{
    <div class="empty-state">
        <div class="empty-state-icon">🏠</div>
        <p class="empty-state-title">@L.T("NoResults")</p>
        <a class="btn btn-primary" asp-action="MyListings">@L.T("ClearFilter")</a>
    </div>
}
else
{
<button type="button" id="compactToggle" class="btn btn-ghost">عرض مدمج</button>
    <div class="cards-grid" id="myListingsGrid">
        @foreach (var listing in Model)
        {
            <div class="my-listing">
                @await Html.PartialAsync("_ListingCard", listing)
                <div class="my-listing-strip">
                    <span class="status-badge status-@listing.Approval">@L.ApprovalText(listing.Approval)</span>
                    <span>👁 @listing.ViewCount</span>
                </div>
                <div class="my-listing-actions">
                    <form asp-action="ToggleAvailability" method="post" class="inline-form">
                        <input type="hidden" name="id" value="@listing.Id" />
                        <button type="submit" class="btn btn-ghost">@(listing.IsAvailable ? L.T("StopListing") : L.T("StartListing"))</button>
                    </form>
                    <a class="btn btn-ghost" asp-action="Delete" asp-route-id="@listing.Id">@L.T("Delete")</a>
                </div>
            </div>
        }
    </div>
}
