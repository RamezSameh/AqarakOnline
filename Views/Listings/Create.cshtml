@model Listing
@{
    var isEdit = Model.Id != 0;
    var listingTypes = new List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>
    {
        new(L.T("ForRent"), "Rent", Model.ListingType == ListingType.Rent),
        new(L.T("ForSale"), "Sale", Model.ListingType == ListingType.Sale)
    };
    var propertyTypes = new List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>();
    foreach (PropertyType type in Enum.GetValues(typeof(PropertyType)))
    {
        propertyTypes.Add(new Microsoft.AspNetCore.Mvc.Rendering.SelectListItem(L.PropertyTypeText(type), type.ToString(), Model.PropertyType == type));
    }
    var action = isEdit ? "Edit" : "Create";
}
<h1>@(isEdit ? L.T("Edit") : L.T("CreateListing"))</h1>

<form asp-action="@action" id="listingForm" method="post" enctype="multipart/form-data" class="form">
    @if (isEdit)
    {
        <input type="hidden" asp-for="Id" />
    }
    <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

    <div class="completeness">
        <span>@L.T("Completeness"): <strong id="completenessPct">0%</strong></span>
        <div class="chart-track"><div class="chart-bar" id="completenessBar" style="width:0%"></div></div>
    </div>

    <div class="form-steps">
        <span class="form-step-item">1 — بيانات الإعلان</span>
        <span class="form-step-item">2 — السعر والمواصفات</span>
        <span class="form-step-item">3 — الصور والفيديو</span>
    </div>
    <div class="steps-progress"><div class="steps-progress-bar" id="stepsProgressBar"></div></div>

    <h2 class="form-step step-1"><span class="step-num">1</span> بيانات الإعلان</h2>

    <label>@L.T("Title")</label>
    <input asp-for="Title" placeholder="مثال: شقة 3 غرف في مدينة نصر" />
    <small id="titleCounter" class="char-counter"></small>
    <span asp-validation-for="Title" class="field-error"></span>

    <label>@L.T("ListingType")</label>
    <select asp-for="ListingType" asp-items="listingTypes"></select>

    <label>@L.T("PropertyType")</label>
    <select asp-for="PropertyType" asp-items="propertyTypes"></select>

    <label>@L.T("AdvertiserType")</label>
    <select asp-for="AdvertiserType">
        <option value="Owner" selected="@(Model.AdvertiserType == AdvertiserType.Owner)">@L.T("FromOwner")</option>
        <option value="Broker" selected="@(Model.AdvertiserType == AdvertiserType.Broker)">@L.T("FromBroker")</option>
    </select>

    <label>@L.T("Area")</label>
    <select asp-for="Area">
        @if (!string.IsNullOrWhiteSpace(Model.Area) && !ListingAreas.All.Contains(Model.Area))
        {
            <option value="@Model.Area" selected>@Model.Area</option>
        }
        @foreach (var area in ListingAreas.All)
        {
            <option value="@area" selected="@(Model.Area == area)">@area</option>
        }
    </select>
    <span asp-validation-for="Area" class="field-error"></span>


    <label>العنوان التفصيلي للعقار (يظهر للأدمن فقط، ولا يظهر للعامة)</label>
    <input asp-for="DetailedAddress" />
    <span asp-validation-for="DetailedAddress" class="field-error"></span>

    <label>@L.T("Details")</label>
    <textarea asp-for="Description" rows="4" placeholder="اكتب وصفًا واضحًا للعقار..."></textarea>
    <small id="descCounter" class="char-counter"></small>
    <span asp-validation-for="Description" class="field-error"></span>

    <label>@L.T("Features")</label>
    <div class="features-picker">
        @foreach (var feature in AqarakOnline.Models.ListingFeatures.All)
        {
            <label><input type="checkbox" name="selectedFeatures" value="@feature" checked="@(Model.FeaturesList.Contains(feature))" /> @feature</label>
        }
    </div>
    <label>@L.T("CustomFeature")</label>
    <input type="text" name="customFeatures" value="@string.Join("، ", Model.FeaturesList.Except(AqarakOnline.Models.ListingFeatures.All))" placeholder="اكتب ميزة مش موجودة في الاختيارات (افصل بين الميزات بفاصلة)" />

    <div class="step-nav">
        <button type="button" class="btn btn-primary step-next" data-target="step-2">التالي ←</button>
    </div>

    <h2 class="form-step step-2"><span class="step-num">2</span> السعر والمواصفات</h2>

    <div class="form-row">
        <div>
    <label>@L.T("Price")</label>
    <input asp-for="Price" type="number" min="0" step="any" placeholder="مثال: 1500000" />
    <span asp-validation-for="Price" class="field-error"></span>
    <small id="suggestedPriceHint"></small>
    <small id="priceFormatted" class="price-formatted"></small>
        </div>
        <div>
    <label>@L.T("AreaSqm")</label>
    <div class="input-unit"><input asp-for="AreaSqm" type="number" min="1" step="1" placeholder="مثال: 120" /><span>م²</span></div>
    <span asp-validation-for="AreaSqm" class="field-error"></span>
        </div>
    </div>

    <label>@L.T("Rooms")</label>
    <input asp-for="Rooms" type="number" min="0" max="50" step="1" />
    <span asp-validation-for="Rooms" class="field-error"></span>

    <label>@L.T("Bathrooms")</label>
    <input asp-for="Bathrooms" type="number" min="0" max="20" step="1" />
    <span asp-validation-for="Bathrooms" class="field-error"></span>

    <div id="floorField" style="@(Model.PropertyType != PropertyType.Apartment ? "display:none;" : "")">
        <label>@L.T("Floor")</label>
        <input asp-for="Floor" type="number" min="0" max="60" step="1" />
        <span asp-validation-for="Floor" class="field-error"></span>
    </div>

    <div id="apartmentsCountField" style="@(Model.PropertyType != PropertyType.Building ? "display:none;" : "")">
        <label>@L.T("ApartmentsCount")</label>
        <input asp-for="ApartmentsCount" type="number" min="1" max="1000" step="1" />
        <span asp-validation-for="ApartmentsCount" class="field-error"></span>
    </div>

    <label>@L.T("Furnishing")</label>
    <select asp-for="Furnishing">
        @foreach (FurnishingLevel level in Enum.GetValues(typeof(FurnishingLevel)))
        {
            <option value="@level" selected="@(Model.Furnishing == level)">@L.FurnishingText(level)</option>
        }
    </select>
    <label>@L.T("Finishing")</label>
    <select asp-for="Finishing">
        <option value="">—</option>
        @foreach (FinishingLevel level in Enum.GetValues(typeof(FinishingLevel)))
        {
            <option value="@level" selected="@(Model.Finishing == level)">@L.FinishingText(level)</option>
        }
    </select>
    <label>@L.T("SaleReason")</label>
    <input asp-for="SaleReason" maxlength="200" placeholder="اختياري — للبيع فقط" />

    <label>@L.T("Amenities")</label>
    <label><input asp-for="HasParking" type="checkbox" /> @L.T("Parking")</label>
    <label><input asp-for="HasElevator" type="checkbox" /> @L.T("Elevator")</label>
    <label>@L.T("ElevatorCount")</label>
    <input asp-for="ElevatorCount" type="number" min="1" max="20" step="1" />
    <span asp-validation-for="ElevatorCount" class="field-error"></span>
    <label><input asp-for="HasBalcony" type="checkbox" /> @L.T("Balcony")</label>
    <label><input asp-for="HasAirConditioning" type="checkbox" /> @L.T("AirConditioning")</label>
    <label><input asp-for="HasSecurity" type="checkbox" /> @L.T("Security")</label>
    <label><input asp-for="AcceptsInstallments" type="checkbox" /> @L.T("AcceptsInstallments")</label>
    <label><input asp-for="IsPriceNegotiable" type="checkbox" /> @L.T("Negotiable")</label>
    <label><input asp-for="IsUrgent" type="checkbox" /> 🔥 @L.T("Urgent")</label>

    <label><input asp-for="HasElectricityMeter" type="checkbox" /> @L.T("ElectricityMeter")</label>
    <label><input asp-for="HasGasMeter" type="checkbox" /> @L.T("GasMeter")</label>
    <label><input asp-for="HasWaterMeter" type="checkbox" /> @L.T("WaterMeter")</label>

    @if (isEdit)
    {
        <label><input asp-for="IsAvailable" type="checkbox" /> @L.T("Available")</label>
    }

    <div class="step-nav">
        <button type="button" class="btn btn-ghost step-prev" data-target="step-1">→ السابق</button>
        <button type="button" class="btn btn-primary step-next" data-target="step-3">التالي ←</button>
    </div>

    <h2 class="form-step step-3"><span class="step-num">3</span> الصور والفيديو</h2>

    <label>صور توضيحية (حتى 5 صور)</label>
    <div id="photoDropZone" class="drop-zone">
        <span>@L.T("DropPhotosHere")</span>
        <input asp-for="PhotoFiles" type="file" accept="image/*" multiple />
        <div id="photoPreview" class="photo-preview"></div>
        <button type="button" id="clearPhotosBtn" class="btn btn-ghost">حذف كل الصور المختارة</button>
    </div>
    <small>الصور بتتصغّر وتتضغط تلقائيًا عند الرفع، وحجم الصورة الواحدة 10 ميجا بحد أقصى.</small>
    <label>فيديو (حتى 25 ميجا)</label>
    <input asp-for="VideoFile" type="file" accept="video/*" />
    <div id="videoPreview" class="video-preview"></div>

    @if (isEdit && Model.Attachments.Any())
    {
        <h3>المرفقات الحالية</h3>
        @foreach (var attachment in Model.Attachments.OrderBy(a => a.Kind).ThenBy(a => a.Order))
        {
            <label>
                <input type="checkbox" name="DeleteAttachmentIds" value="@attachment.Id" />
                حذف: @(attachment.Kind == AttachmentKind.Photo ? "صورة" : "فيديو") - @attachment.OriginalFileName
            </label>
        }
    }

    <div id="uploadStatus" class="upload-progress" hidden><div class="upload-progress-bar"></div><span>@L.T("UploadingListing")</span></div>

    <div class="step-nav">
        <button type="button" class="btn btn-ghost step-prev" data-target="step-2">→ السابق</button>
        <button type="button" class="btn btn-primary step-next" data-target="step-4">مراجعة ←</button>
    </div>

    <h2 class="form-step step-4"><span class="step-num">4</span> مراجعة الإعلان</h2>
    <div id="reviewPanel" class="review-panel"></div>

    <div class="actions">
        <button type="submit" class="btn btn-primary">@L.T("Save")</button>
        <button type="button" id="previewListingBtn" class="btn btn-ghost">👁 @L.T("PreviewListing")</button>
        <a class="btn btn-ghost" asp-action="Index">@L.T("Cancel")</a>
    </div>
</form>

<div id="listingPreview" class="listing-preview" hidden></div>
