@model IEnumerable<Listing>
@section Meta {
    @if (ViewBag.AreaPage != null)
    {
        <link rel="canonical" href="@ViewBag.CanonicalUrl" />
        <meta property="og:title" content="إعلانات @ViewBag.AreaPage" />
        <meta property="og:description" content="شقق وفيلات ومحلات للبيع والإيجار في @ViewBag.AreaPage — عقارك أونلاين." />
        <meta property="og:type" content="website" />
        <meta property="og:url" content="@ViewBag.CanonicalUrl" />
    }
}
@{
    var listingTypes = new List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>
    {
        new(L.T("All"), ""),
        new(L.T("ForSale"), "Sale", ViewBag.ListingType == ListingType.Sale),
        new(L.T("ForRent"), "Rent", ViewBag.ListingType == ListingType.Rent)
    };
    var propertyTypes = new List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>
    {
        new(L.T("All"), "")
    };
    foreach (PropertyType type in Enum.GetValues(typeof(PropertyType)))
    {
        propertyTypes.Add(new Microsoft.AspNetCore.Mvc.Rendering.SelectListItem(L.PropertyTypeText(type), type.ToString(), ViewBag.PropertyType == type));
    }
    var sortOptions = new List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>
    {
        new(L.T("SortNewest"), "newest", ViewBag.Sort == "newest"),
        new(L.T("SortPriceAsc"), "priceAsc", ViewBag.Sort == "priceAsc"),
        new(L.T("SortPriceDesc"), "priceDesc", ViewBag.Sort == "priceDesc"),
        new(L.T("SortAreaDesc"), "areaDesc", ViewBag.Sort == "areaDesc"),
        new(L.T("SortViewsDesc"), "viewsDesc", ViewBag.Sort == "viewsDesc"),
        new(L.T("SortPricePerSqmAsc"), "pricePerSqmAsc", ViewBag.Sort == "pricePerSqmAsc"),
        new(L.T("SortPricePerSqmDesc"), "pricePerSqmDesc", ViewBag.Sort == "pricePerSqmDesc"),
        new(L.T("SortRoomsDesc"), "roomsDesc", ViewBag.Sort == "roomsDesc"),
        new(L.T("SortRoomsAsc"), "roomsAsc", ViewBag.Sort == "roomsAsc"),
        new(L.T("SortOldest"), "oldest", ViewBag.Sort == "oldest")
    };
    var listingTypeValue = ViewBag.ListingType?.ToString() ?? "";
    var propertyTypeValue = ViewBag.PropertyType?.ToString() ?? "";
    var areaValue = ViewBag.Area?.ToString() ?? "";
    var areaOptions = new List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>
    {
        new(L.T("All"), "")
    };
    var areaCounts = ViewBag.AreaCounts as Dictionary<string, int>;
    foreach (var areaName in AqarakOnline.Models.ListingAreas.All)
    {
        var areaLabel = areaCounts != null && areaCounts.TryGetValue(areaName, out var areaCount) && areaCount > 0
            ? $"{areaName} ({areaCount})" : areaName;
        areaOptions.Add(new Microsoft.AspNetCore.Mvc.Rendering.SelectListItem(areaLabel, areaName, areaValue == areaName));
    }
    var finishingOptions = new List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>
    {
        new(L.T("All"), "")
    };
    foreach (FinishingLevel level in Enum.GetValues(typeof(FinishingLevel)))
    {
        finishingOptions.Add(new Microsoft.AspNetCore.Mvc.Rendering.SelectListItem(L.FinishingText(level), level.ToString(), ViewBag.Finishing == level));
    }
    var recencyOptions = new List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>
    {
        new(L.T("RecencyAny"), "any", ViewBag.Recency == "any"),
        new(L.T("RecencyToday"), "today", ViewBag.Recency == "today"),
        new(L.T("RecencyWeek"), "week", ViewBag.Recency == "week"),
        new(L.T("RecencyMonth"), "month", ViewBag.Recency == "month")
    };
    var rentPeriodOptions = new List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>
    {
        new(L.T("All"), ""),
        new(L.T("Monthly"), "Monthly", ViewBag.RentPeriod == RentPeriod.Monthly),
        new(L.T("Yearly"), "Yearly", ViewBag.RentPeriod == RentPeriod.Yearly)
    };
    var currentPage = (int)(ViewBag.Page ?? 1);
    var totalPages = (int)(ViewBag.TotalPages ?? 1);
    var totalCount = (int)(ViewBag.TotalCount ?? 0);
}
<h1>@(ViewBag.AreaPage != null ? "إعلانات " + ViewBag.AreaPage : L.T("Listings"))</h1>

<details class="filters-box" open>
    <summary>@L.T("Filters")</summary>
    <form class="filter-form" asp-action="Index" method="get">
        <input type="text" name="search" value="@ViewBag.Search" placeholder="@L.T("SearchPlaceholder")" />
        <input type="text" name="adNumber" value="@ViewBag.AdNumber" placeholder="@L.T("SearchByAdNumber")" />
        <select name="area" asp-items="areaOptions"></select>
        <select name="listingType" asp-items="listingTypes"></select>
        <select name="propertyType" asp-items="propertyTypes"></select>
        <input type="number" name="minPrice" value="@ViewBag.MinPrice" placeholder="@L.T("MinPrice")" min="0" step="any" />
        <input type="number" name="maxPrice" value="@ViewBag.MaxPrice" placeholder="@L.T("MaxPrice")" min="0" step="any" />
        <input type="number" name="minArea" value="@ViewBag.MinArea" placeholder="@L.T("MinArea")" min="1" step="1" />
        <input type="number" name="maxArea" value="@ViewBag.MaxArea" placeholder="@L.T("MaxArea")" min="1" step="1" />
        <input type="number" name="minRooms" value="@ViewBag.MinRooms" placeholder="@L.T("MinRooms")" min="0" step="1" />
        <input type="number" name="minFloor" value="@ViewBag.MinFloor" placeholder="@L.T("MinFloor")" min="0" step="1" />
        <input type="number" name="maxFloor" value="@ViewBag.MaxFloor" placeholder="@L.T("MaxFloor")" min="0" step="1" />
        <label><input type="checkbox" name="furnishedOnly" value="true" checked="@(ViewBag.FurnishedOnly == true)" /> @L.T("FurnishedOnly")</label>
        <select name="finishing" asp-items="finishingOptions"></select>
        <label class="sort-label">
            @L.T("Recency")
            <select name="recency" asp-items="recencyOptions"></select>
        </label>
        <label><input type="checkbox" name="directOwnerOnly" value="true" checked="@(ViewBag.DirectOwnerOnly == true)" /> @L.T("DirectOwnerOnly")</label>
        <label><input type="checkbox" name="hasParking" value="true" checked="@(ViewBag.HasParking == true)" /> @L.T("Parking")</label>
        <label><input type="checkbox" name="hasElevator" value="true" checked="@(ViewBag.HasElevator == true)" /> @L.T("Elevator")</label>
        <label><input type="checkbox" name="hasBalcony" value="true" checked="@(ViewBag.HasBalcony == true)" /> @L.T("Balcony")</label>
        <label><input type="checkbox" name="hasAirConditioning" value="true" checked="@(ViewBag.HasAirConditioning == true)" /> @L.T("AirConditioning")</label>
        <label><input type="checkbox" name="hasSecurity" value="true" checked="@(ViewBag.HasSecurity == true)" /> @L.T("Security")</label>
        <label><input type="checkbox" name="installmentsOnly" value="true" checked="@(ViewBag.InstallmentsOnly == true)" /> @L.T("InstallmentsOnly")</label>
        <label><input type="checkbox" name="negotiableOnly" value="true" checked="@(ViewBag.NegotiableOnly == true)" /> @L.T("NegotiableOnly")</label>
        <select name="rentPeriod" asp-items="rentPeriodOptions"></select>
        <label><input type="checkbox" name="hasElectricityMeter" value="true" checked="@(ViewBag.HasElectricityMeter == true)" /> @L.T("ElectricityMeter")</label>
        <label><input type="checkbox" name="hasGasMeter" value="true" checked="@(ViewBag.HasGasMeter == true)" /> @L.T("GasMeter")</label>
        <label><input type="checkbox" name="hasWaterMeter" value="true" checked="@(ViewBag.HasWaterMeter == true)" /> @L.T("WaterMeter")</label>
        <input type="number" name="minBuildingFloors" value="@ViewBag.MinBuildingFloors" placeholder="@L.T("MinBuildingFloors")" min="0" step="1" />
        <label class="sort-label">
            @L.T("SortBy")
            <select name="sort" asp-items="sortOptions"></select>
        </label>
        <label><input type="checkbox" name="onlyAvailable" value="true" checked="@(ViewBag.OnlyAvailable == true)" /> @L.T("OnlyAvailable")</label>
        <button type="submit" class="btn btn-primary">@L.T("Filter")</button>
        <a class="btn btn-ghost" asp-action="Index">@L.T("ClearFilter")</a>
    </form>
</details>

<div class="results-bar">
    <span>@L.T("ResultsCount"): @totalCount</span>
    @if (totalPages > 1)
    {
        <span>@currentPage / @totalPages</span>
    }
    @if (User.Identity?.IsAuthenticated == true)
    {
        <form asp-controller="SavedSearches" asp-action="Create" method="post" class="inline-form">
            <input type="hidden" name="search" value="@ViewBag.Search" />
            <input type="hidden" name="area" value="@areaValue" />
            <input type="hidden" name="listingType" value="@listingTypeValue" />
            <input type="hidden" name="propertyType" value="@propertyTypeValue" />
            <input type="hidden" name="minPrice" value="@ViewBag.MinPrice" />
            <input type="hidden" name="maxPrice" value="@ViewBag.MaxPrice" />
            <input type="hidden" name="minArea" value="@ViewBag.MinArea" />
            <input type="hidden" name="maxArea" value="@ViewBag.MaxArea" />
            <input type="hidden" name="minRooms" value="@ViewBag.MinRooms" />
            <input type="hidden" name="furnishedOnly" value="@(ViewBag.FurnishedOnly == true ? "true" : "false")" />
            <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
            <button type="submit" class="btn btn-ghost">🔔 @L.T("SaveSearch")</button>
        </form>
    }
</div>

@if (!Model.Any())
{
    <p class="empty-results">@L.T("NoResults")<br />@L.T("TryClearFilters")</p>
}
else
{
    <div class="cards-grid">
        @foreach (var listing in Model)
        {
            @await Html.PartialAsync("_ListingCard", listing)
        }
    </div>
    @if (totalPages > 1)
    {
        <nav class="pagination" aria-label="Pagination">
            <a class="btn btn-ghost @(currentPage <= 1 ? "disabled" : "")"
               asp-action="Index" asp-route-search="@ViewBag.Search" asp-route-listingType="@listingTypeValue" asp-route-propertyType="@propertyTypeValue" asp-route-area="@areaValue"
               asp-route-minPrice="@ViewBag.MinPrice" asp-route-maxPrice="@ViewBag.MaxPrice" asp-route-minArea="@ViewBag.MinArea" asp-route-maxArea="@ViewBag.MaxArea"
               asp-route-sort="@ViewBag.Sort" asp-route-onlyAvailable="@ViewBag.OnlyAvailable" asp-route-minRooms="@ViewBag.MinRooms" asp-route-furnishedOnly="@ViewBag.FurnishedOnly" asp-route-adNumber="@ViewBag.AdNumber" asp-route-recency="@ViewBag.Recency" asp-route-directOwnerOnly="@ViewBag.DirectOwnerOnly" asp-route-finishing="@ViewBag.Finishing" asp-route-minFloor="@ViewBag.MinFloor" asp-route-maxFloor="@ViewBag.MaxFloor" asp-route-hasParking="@ViewBag.HasParking" asp-route-hasElevator="@ViewBag.HasElevator" asp-route-hasBalcony="@ViewBag.HasBalcony" asp-route-hasAirConditioning="@ViewBag.HasAirConditioning" asp-route-hasSecurity="@ViewBag.HasSecurity" asp-route-installmentsOnly="@ViewBag.InstallmentsOnly" asp-route-negotiableOnly="@ViewBag.NegotiableOnly" asp-route-rentPeriod="@ViewBag.RentPeriod" asp-route-hasElectricityMeter="@ViewBag.HasElectricityMeter" asp-route-hasGasMeter="@ViewBag.HasGasMeter" asp-route-hasWaterMeter="@ViewBag.HasWaterMeter" asp-route-minBuildingFloors="@ViewBag.MinBuildingFloors" asp-route-page="@(currentPage - 1)">@L.T("Previous")</a>
            @for (var p = 1; p <= totalPages; p++)
            {
                <a class="btn btn-ghost" aria-current="@(p == currentPage ? "page" : null)"
                   asp-action="Index" asp-route-search="@ViewBag.Search" asp-route-listingType="@listingTypeValue" asp-route-propertyType="@propertyTypeValue" asp-route-area="@areaValue"
                   asp-route-minPrice="@ViewBag.MinPrice" asp-route-maxPrice="@ViewBag.MaxPrice" asp-route-minArea="@ViewBag.MinArea" asp-route-maxArea="@ViewBag.MaxArea"
                   asp-route-sort="@ViewBag.Sort" asp-route-onlyAvailable="@ViewBag.OnlyAvailable" asp-route-minRooms="@ViewBag.MinRooms" asp-route-furnishedOnly="@ViewBag.FurnishedOnly" asp-route-adNumber="@ViewBag.AdNumber" asp-route-recency="@ViewBag.Recency" asp-route-directOwnerOnly="@ViewBag.DirectOwnerOnly" asp-route-finishing="@ViewBag.Finishing" asp-route-minFloor="@ViewBag.MinFloor" asp-route-maxFloor="@ViewBag.MaxFloor" asp-route-hasParking="@ViewBag.HasParking" asp-route-hasElevator="@ViewBag.HasElevator" asp-route-hasBalcony="@ViewBag.HasBalcony" asp-route-hasAirConditioning="@ViewBag.HasAirConditioning" asp-route-hasSecurity="@ViewBag.HasSecurity" asp-route-installmentsOnly="@ViewBag.InstallmentsOnly" asp-route-negotiableOnly="@ViewBag.NegotiableOnly" asp-route-rentPeriod="@ViewBag.RentPeriod" asp-route-hasElectricityMeter="@ViewBag.HasElectricityMeter" asp-route-hasGasMeter="@ViewBag.HasGasMeter" asp-route-hasWaterMeter="@ViewBag.HasWaterMeter" asp-route-minBuildingFloors="@ViewBag.MinBuildingFloors" asp-route-page="@p">@p</a>
            }
            <a class="btn btn-ghost @(currentPage >= totalPages ? "disabled" : "")"
               asp-action="Index" asp-route-search="@ViewBag.Search" asp-route-listingType="@listingTypeValue" asp-route-propertyType="@propertyTypeValue" asp-route-area="@areaValue"
               asp-route-minPrice="@ViewBag.MinPrice" asp-route-maxPrice="@ViewBag.MaxPrice" asp-route-minArea="@ViewBag.MinArea" asp-route-maxArea="@ViewBag.MaxArea"
               asp-route-sort="@ViewBag.Sort" asp-route-onlyAvailable="@ViewBag.OnlyAvailable" asp-route-minRooms="@ViewBag.MinRooms" asp-route-furnishedOnly="@ViewBag.FurnishedOnly" asp-route-adNumber="@ViewBag.AdNumber" asp-route-recency="@ViewBag.Recency" asp-route-directOwnerOnly="@ViewBag.DirectOwnerOnly" asp-route-finishing="@ViewBag.Finishing" asp-route-minFloor="@ViewBag.MinFloor" asp-route-maxFloor="@ViewBag.MaxFloor" asp-route-hasParking="@ViewBag.HasParking" asp-route-hasElevator="@ViewBag.HasElevator" asp-route-hasBalcony="@ViewBag.HasBalcony" asp-route-hasAirConditioning="@ViewBag.HasAirConditioning" asp-route-hasSecurity="@ViewBag.HasSecurity" asp-route-installmentsOnly="@ViewBag.InstallmentsOnly" asp-route-negotiableOnly="@ViewBag.NegotiableOnly" asp-route-rentPeriod="@ViewBag.RentPeriod" asp-route-hasElectricityMeter="@ViewBag.HasElectricityMeter" asp-route-hasGasMeter="@ViewBag.HasGasMeter" asp-route-hasWaterMeter="@ViewBag.HasWaterMeter" asp-route-minBuildingFloors="@ViewBag.MinBuildingFloors" asp-route-page="@(currentPage + 1)">@L.T("Next")</a>
        </nav>
    }
}
