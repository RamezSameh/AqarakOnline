@model Listing
@inject AqarakOnline.Services.TrustedAdvertiserService TrustedAdvertiser
@{
    var detailsUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    var isOwnListing = !string.IsNullOrEmpty(detailsUserId) && Model.OwnerId == detailsUserId;
    var pageUrl = $"{Context.Request.Scheme}://{Context.Request.Host}/Listings/Details/{Model.Id}";
    var firstPhoto = Model.Attachments.Where(a => a.Kind == AttachmentKind.Photo).OrderBy(a => a.Order).ThenBy(a => a.Id).FirstOrDefault();
    var shareText = $"{Model.Title} - {L.PriceText(Model.Price, Model.ListingType)} - {pageUrl}";
    var typeIcon = Model.PropertyType switch
    {
        PropertyType.Apartment => "🏢",
        PropertyType.House => "🏠",
        PropertyType.Building => "🏗️",
        PropertyType.Shop => "🏪",
        PropertyType.Villa => "🏰",
        _ => ""
    };
    var jsonLd = System.Text.Json.JsonSerializer.Serialize(new Dictionary<string, object>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "RealEstateListing",
        ["name"] = Model.Title,
        ["description"] = Model.Description,
        ["url"] = pageUrl,
        ["datePosted"] = Model.CreatedAt.ToString("yyyy-MM-dd"),
        ["offers"] = new Dictionary<string, object>
        {
            ["@type"] = "Offer",
            ["price"] = Model.Price.ToString(System.Globalization.CultureInfo.InvariantCulture),
            ["priceCurrency"] = "EGP"
        }
    });
}
@section Meta {
    <meta property="og:title" content="@Model.Title" />
    <meta property="og:description" content="@Model.Description" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="@pageUrl" />
    @if (firstPhoto != null)
    {
        <meta property="og:image" content="@($"{Context.Request.Scheme}://{Context.Request.Host}/{firstPhoto.FilePath}")" />
    }
    <script type="application/ld+json">@Html.Raw(jsonLd)</script>
}
<div class="reading-progress"><div id="readingProgressBar"></div></div>
<h1 class="details-title">@typeIcon @Model.Title</h1>
<div class="listing-meta">
    <span class="badge @(Model.ListingType == ListingType.Sale ? "badge-sale" : "badge-rent")">@L.ListingTypeText(Model.ListingType)</span>
    <span class="badge badge-pt-@Model.PropertyType">@L.PropertyTypeText(Model.PropertyType)</span>
    @if (Model.IsEffectivelyFeatured)
    {
        <span class="badge badge-featured">⭐ @L.T("Featured")</span>
    }
    @if (Model.IsUrgent)
    {
        <span class="badge badge-urgent">🔥 @L.T("Urgent")</span>
    }
    @if (await TrustedAdvertiser.IsTrustedAsync(Model.OwnerId))
    {
        <span class="badge badge-trusted">✓ @L.T("TrustedAdvertiser")</span>
    }
    @if (Model.CreatedAt >= DateTime.UtcNow.AddDays(-1))
    {
        <span class="badge badge-new">🆕 @L.T("New")</span>
    }
    <span class="ad-number">@L.T("AdNumber"): @Model.AdNumber</span>
    <span class="listing-status @(Model.IsAvailable ? "available" : "closed")">@(Model.IsAvailable ? L.T("Available") : L.T("NotAvailable"))</span>
</div>

<div class="details-quick-summary">
    <span>💰 @L.PriceText(Model.Price, Model.ListingType)</span>
    <span>📐 @Model.AreaSqm م²</span>
    @if (Model.Rooms.HasValue)
    {
        <span>🛏️ @Model.Rooms</span>
    }
    <span>@typeIcon @L.PropertyTypeText(Model.PropertyType)</span>
    <span>📍 @Model.Area</span>
</div>

@{
    var photos = Model.Attachments.Where(a => a.Kind == AttachmentKind.Photo).OrderBy(a => a.Order).ThenBy(a => a.Id).ToList();
    var video = Model.Attachments.FirstOrDefault(a => a.Kind == AttachmentKind.Video);
}
@if (photos.Any())
{
    <div class="gallery" id="gallery">
        <div class="gallery-main">
            <img id="galleryMain" class="gallery-main-photo" src="/@photos[0].FilePath" alt="@Model.Title" />
            <span id="galleryCounter" class="gallery-counter">1 / @photos.Count</span>
            <button type="button" id="galleryAutoplay" class="gallery-autoplay" aria-label="تشغيل تلقائي">▶</button>
            <button type="button" id="galleryPrev" class="gallery-nav gallery-prev" aria-label="@L.T("Previous")">‹</button>
            <button type="button" id="galleryNext" class="gallery-nav gallery-next" aria-label="@L.T("Next")">›</button>
        </div>
        @if (photos.Count > 1)
        {
            <div class="gallery-thumbs">
                @for (var i = 0; i < photos.Count; i++)
                {
                    <button type="button" class="gallery-thumb @(i == 0 ? "active" : "")" data-index="@i" aria-label="@(i + 1)">
                        <img src="/@photos[i].FilePath" alt="@Model.Title @(i + 1)" loading="lazy" />
                    </button>
                }
            </div>
        }
    </div>
    <div id="lightbox" class="lightbox" hidden>
        <button type="button" id="lightboxClose" class="lightbox-close" aria-label="@L.T("Close")">✕</button>
        <button type="button" id="lightboxPrev" class="lightbox-nav lightbox-prev" aria-label="@L.T("Previous")">‹</button>
        <img id="lightboxImg" class="lightbox-img" src="" alt="@Model.Title" />
        <button type="button" id="lightboxNext" class="lightbox-nav lightbox-next" aria-label="@L.T("Next")">›</button>
        <span id="lightboxCounter" class="lightbox-counter"></span>
        <a id="lightboxDownload" class="lightbox-download" href="#" download>⬇ تحميل الصورة</a>
    </div>
}
else
{
    <div class="detail-photo placeholder">@L.T("NoPhoto")</div>
}
@if (video != null)
{
    <video class="detail-video" controls src="/@video.FilePath"></video>
}

<details class="details-accordion" open><summary>المواصفات</summary>
<div class="details-facts">
<p><strong>@L.T("Area"):</strong> @Model.Area</p>
<p><strong>@L.T("AreaSqm"):</strong> @Model.AreaSqm</p>
<p><strong>@L.T("AdvertiserType"):</strong> @L.AdvertiserTypeText(Model.AdvertiserType)</p>
@if (Model.Rooms.HasValue)
{
    <p><strong>@L.T("Rooms"):</strong> @Model.Rooms</p>
}
@if (Model.Bathrooms.HasValue)
{
    <p><strong>@L.T("Bathrooms"):</strong> @Model.Bathrooms</p>
}
@if (Model.Floor.HasValue)
{
    <p><strong>@L.T("Floor"):</strong> @Model.Floor</p>
}
@if (Model.Furnishing != FurnishingLevel.None)
{
    <p><strong>@L.T("Furnishing"):</strong> @L.FurnishingText(Model.Furnishing)</p>
}
@if (Model.ListingType == ListingType.Sale && !string.IsNullOrWhiteSpace(Model.SaleReason))
{
    <p><strong>@L.T("SaleReason"):</strong> @Model.SaleReason</p>
}
@if (Model.Finishing.HasValue)
{
    <p><strong>@L.T("Finishing"):</strong> @L.FinishingText(Model.Finishing.Value)</p>
}
@if (Model.LandAreaSqm.HasValue)
{
    <p><strong>@L.T("LandArea"):</strong> @Model.LandAreaSqm م²</p>
}
@if (Model.BuildingFloors.HasValue)
{
    <p><strong>@L.T("BuildingFloors"):</strong> @Model.BuildingFloors</p>
}
@if (Model.ApartmentsCount.HasValue)
{
    <p><strong>@L.T("ApartmentsCount"):</strong> @Model.ApartmentsCount</p>
}
@if (Model.ElevatorCount.HasValue)
{
    <p><strong>@L.T("ElevatorCount"):</strong> @Model.ElevatorCount</p>
}
</div>
<h3 class="details-subhead">السعر والدفع</h3>
<div class="details-facts">
<p class="details-price"><strong>@L.T("Price"):</strong> @L.PriceText(Model.Price, Model.ListingType)</p>
@if (Model.IsPriceReduced)
{
    <p><strong>@L.T("OriginalPrice"):</strong> <del>@Model.OriginalPrice.ToString("N0") جنيه</del></p>
}
@if (Model.ListingType == ListingType.Rent)
{
    if (Model.RentPeriod.HasValue)
    {
        <p><strong>@L.T("RentPeriod"):</strong> @(Model.RentPeriod.Value == RentPeriod.Monthly ? L.T("Monthly") : L.T("Yearly"))</p>
    }
    if (Model.DepositMonths.HasValue)
    {
        <p><strong>@L.T("DepositMonths"):</strong> @Model.DepositMonths</p>
    }
}
@{
    var avgSqm = ViewBag.AreaAvgPricePerSqm as decimal?;
    var mySqm = ViewBag.PricePerSqm as decimal?;
}
@if (avgSqm.HasValue && mySqm.HasValue)
{
    var diff = (mySqm.Value - avgSqm.Value) / avgSqm.Value * 100;
    <p class="fact-wide"><strong>متوسط سعر المتر في @Model.Area:</strong> @avgSqm.Value.ToString("N0") جنيه/م² — سعر المتر في الإعلان ده: @mySqm.Value.ToString("N0") جنيه/م² (@(diff < -0.5m ? $"أقل من المتوسط بنسبة {Math.Abs(diff):0}%" : diff > 0.5m ? $"أعلى من المتوسط بنسبة {diff:0}%" : "يساوي متوسط المنطقة"))</p>
}
</div>
@if (Model.IsPriceNegotiable || Model.AcceptsInstallments)
{
<div class="details-chips">
@if (Model.IsPriceNegotiable)
{
    <span class="badge">✓ @L.T("Negotiable")</span>
}
@if (Model.AcceptsInstallments)
{
    <span class="badge">✓ @L.T("AcceptsInstallments")</span>
}
</div>
}
</details>
<p class="details-meta">👁 @Model.ViewCount @L.T("Views") • @L.T("PublishedAt"): @L.RelativeTime(Model.CreatedAt)@if (Model.UpdatedAt.HasValue){<text> • @L.T("LastUpdated"): @L.RelativeTime(Model.UpdatedAt.Value)</text>}</p>

@if (User.IsInRole("Admin"))
{
<div class="admin-box">
    <h2>@L.T("AdvertiserData")</h2>
    <p><strong>@L.T("PhoneNumber"):</strong> @(Model.Owner?.PhoneNumber ?? "-")</p>
    <p><strong>@L.T("Address"):</strong> @(Model.Owner?.Address ?? "-")</p>
    @if (!string.IsNullOrWhiteSpace(Model.DetailedAddress))
    {
        <p><strong>العنوان التفصيلي للعقار (للأدمن فقط):</strong> @Model.DetailedAddress</p>
    }
    <p><strong>@L.T("ApprovalStatus"):</strong> @L.ApprovalText(Model.Approval)</p>
</div>
}

@if (!string.IsNullOrWhiteSpace(Model.Description))
{
<section class="details-section">
    <h2>@L.T("Details")</h2>
    <p>@Model.Description</p>
</section>
}
@if (Model.FeaturesList.Any())
{
<section class="details-section">
    <h2>@L.T("Features")</h2>
    <ul class="features-chips">
        @foreach (var feature in Model.FeaturesList)
        {
            <li>@feature</li>
        }
    </ul>
</section>
}
@if (Model.HasElectricityMeter || Model.HasGasMeter || Model.HasWaterMeter || Model.HasParking || Model.HasElevator || Model.HasBalcony || Model.HasAirConditioning || Model.HasSecurity)
{
<section class="meters-table">
    <h2>العدادات والمرافق</h2>
    <div class="meters-grid">
        @if (Model.HasElectricityMeter || Model.HasGasMeter || Model.HasWaterMeter)
        {
        <div>
            <h3>@L.T("Meters")</h3>
            <table class="table">
                @if (Model.HasElectricityMeter)
                {
                <tr><td>@L.T("ElectricityMeter")</td><td>✓</td></tr>
                }
                @if (Model.HasGasMeter)
                {
                <tr><td>@L.T("GasMeter")</td><td>✓</td></tr>
                }
                @if (Model.HasWaterMeter)
                {
                <tr><td>@L.T("WaterMeter")</td><td>✓</td></tr>
                }
            </table>
        </div>
        }
        @if (Model.HasParking || Model.HasElevator || Model.HasBalcony || Model.HasAirConditioning || Model.HasSecurity)
        {
        <div>
            <h3>@L.T("Amenities")</h3>
            <table class="table">
                @if (Model.HasParking)
                {
                <tr><td>@L.T("Parking")</td><td>✓</td></tr>
                }
                @if (Model.HasElevator)
                {
                <tr><td>@L.T("Elevator")</td><td>✓</td></tr>
                }
                @if (Model.HasBalcony)
                {
                <tr><td>@L.T("Balcony")</td><td>✓</td></tr>
                }
                @if (Model.HasAirConditioning)
                {
                <tr><td>@L.T("AirConditioning")</td><td>✓</td></tr>
                }
                @if (Model.HasSecurity)
                {
                <tr><td>@L.T("Security")</td><td>✓</td></tr>
                }
            </table>
        </div>
        }
    </div>
</section>
}
    @if (User.Identity?.IsAuthenticated == true)
    {
        var isFavorite = ViewBag.IsFavorite == true;
        <form asp-controller="Favorites" asp-action="Toggle" method="post" class="inline-form">
            <input type="hidden" name="listingId" value="@Model.Id" />
            <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
            <button type="submit" class="btn btn-ghost favorite-btn @(isFavorite ? "is-favorite" : "")" data-add="❤️ إضافة إلى المفضلة" data-added="❤️ في المفضلة">@(isFavorite ? "❤️ في المفضلة" : "❤️ إضافة إلى المفضلة")</button>
        </form>
    }
    else
    {
        <button type="button" class="btn btn-ghost favorite-btn guest-favorite guest-fav-details" data-id="@Model.Id" title="إضافة إلى المفضلة">❤️ إضافة إلى المفضلة</button>
    }
    @if (isOwnListing)
    {
        <p class="alert-info">@L.T("OwnListingNote")</p>
        <form asp-action="Bump" method="post" class="inline-form">
            <input type="hidden" name="id" value="@Model.Id" />
            <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
            <button type="submit" class="btn btn-ghost">🔄 @L.T("RenewListing")</button>
        </form>
        <form asp-action="Duplicate" method="post" class="inline-form">
            <input type="hidden" name="id" value="@Model.Id" />
            <button type="submit" class="btn btn-ghost">📋 @L.T("CopyListing")</button>
        </form>
    }
    else if (Model.IsAvailable)
    {
        @if (Model.ListingType == ListingType.Sale)
        {
            <a class="btn btn-primary" asp-controller="Contact" asp-action="Contact" asp-route-listingId="@Model.Id" asp-route-intent="buy">@L.T("Buy")</a>
        }
        else
        {
            <a class="btn btn-primary" asp-controller="Contact" asp-action="Contact" asp-route-listingId="@Model.Id" asp-route-intent="rent">@L.T("RentIt")</a>
        }
        <a class="btn btn-ghost" asp-controller="Contact" asp-action="Contact" asp-route-listingId="@Model.Id">@L.T("ContactUs")</a>
        <a class="btn btn-ghost" href="tel:@ContactOptions.Value.Phone">📞 @L.T("CallUs")</a>
        <a class="btn btn-ghost report-btn" asp-action="Report" asp-route-id="@Model.Id">🚩 @L.T("ReportListing")</a>
    }
    @* Batch 41 (2) — عرض سعر عبر الأدمن (ليس لصاحب الإعلان). *@
    @if (User.Identity?.IsAuthenticated == true && Model.OwnerId != User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value && Model.IsAvailable)
    {
        @if (ViewBag.MyPendingOffer is ListingOffer pendingOffer)
        {
            <p class="alert-info">💰 عرضك @pendingOffer.Amount.ToString("N0") جنيه بانتظار رد صاحب الإعلان — <a asp-controller="Offers" asp-action="MyOffers">عروضي</a>.</p>
        }
        else
        {
            <details class="viewing-details">
                <summary>💰 قدّم عرض سعر</summary>
                <form asp-controller="Offers" asp-action="Create" method="post" class="form">
                    <input type="hidden" name="listingId" value="@Model.Id" />
                    <p><small>عرضك بيوصل لصاحب الإعلان عن طريق إدارة الموقع — بدون تواصل مباشر.</small></p>
                    <label>مبلغ العرض (جنيه) *</label>
                    <input type="number" name="amount" min="1" required placeholder="@Model.Price.ToString("N0")" />
                    <label>رسالة (اختياري)</label>
                    <textarea name="message" rows="2" maxlength="500"></textarea>
                    <button type="submit" class="btn btn-primary">إرسال العرض</button>
                </form>
            </details>
        }
    }
    @if (User.Identity?.IsAuthenticated == true && (Model.OwnerId == User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value || User.IsInRole("Admin")))
    {
        <a class="btn btn-ghost" asp-action="Edit" asp-route-id="@Model.Id">@L.T("Edit")</a>
        <a class="btn btn-ghost" asp-action="Delete" asp-route-id="@Model.Id">@L.T("Delete")</a>
        <a class="btn btn-ghost" asp-controller="Viewings" asp-action="Slots" asp-route-listingId="@Model.Id">📅 أوقات المعاينة</a>
    }
</div>

@if (Model.Approval == ListingApproval.Rejected && !string.IsNullOrWhiteSpace(Model.RejectionReason) && (isOwnListing || User.IsInRole("Admin")))
{
    <p class="alert-error"><strong>@L.T("RejectionReason"):</strong> @Model.RejectionReason</p>
}

<div class="share-row">
    <span>@L.T("Share"):</span>
    <a class="btn btn-ghost share-icon" href="https://wa.me/?text=@Uri.EscapeDataString(shareText)" target="_blank" rel="noopener" title="واتساب">💬</a>
    <a class="btn btn-ghost share-icon" href="https://www.facebook.com/sharer/sharer.php?u=@Uri.EscapeDataString(pageUrl)" target="_blank" rel="noopener" title="فيسبوك">f</a>
    <a class="btn btn-ghost share-icon" href="https://t.me/share/url?url=@Uri.EscapeDataString(pageUrl)&text=@Uri.EscapeDataString(shareText)" target="_blank" rel="noopener" title="تيليجرام">✈️</a>
    <button type="button" class="btn btn-ghost share-icon share-copy" data-url="@pageUrl" title="@L.T("CopyLink")">🔗</button>
    <button type="button" class="btn btn-ghost share-icon share-copy" data-url="@Model.AdNumber" title="نسخ رقم الإعلان">🔢</button>
    <button type="button" class="btn btn-ghost share-icon compare-toggle" data-id="@Model.Id" data-add="⚖️" data-added="✓" data-max="@L.T("CompareMax")" title="@L.T("AddToCompare")">⚖️</button>
</div>


{
    <details class="viewing-details">
        <summary>📅 @L.T("BookViewing")</summary>
    <section class="viewing-form">
        <p><small>المعاينة بتتنسق عن طريق إدارة الموقع — لا يوجد تواصل مباشر مع المعلن.</small></p>
        <form asp-controller="Viewings" asp-action="Create" method="post" class="form">
            <input type="hidden" name="listingId" value="@Model.Id" />
            @if (ViewBag.AvailableSlots is List<ViewingSlot> slots && slots.Any())
            {
                @* Batch 41 (7) — مواعيد متاحة حددها صاحب الإعلان: اختيار منها بدل وقت حر. *@
                <label>1 — اختر من المواعيد المتاحة</label>
                <div class="time-chips">
                    @foreach (var slot in slots)
                    {
                        <label class="btn btn-ghost time-chip"><input type="radio" name="slotId" value="@slot.Id" required /> @slot.SlotDate.ToString("dd/MM/yyyy") • @slot.StartTime.ToString(@"hh\:mm") - @slot.EndTime.ToString(@"hh\:mm")</label>
                    }
                </div>
            }
            else
            {
                <label>1 — @L.T("ViewingDate")</label>
                <input type="datetime-local" id="requestedAtInput" name="requestedAt" min="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" required />
                <div class="time-chips">
                    <button type="button" class="btn btn-ghost time-chip" data-time="10:00">صباحًا</button>
                    <button type="button" class="btn btn-ghost time-chip" data-time="18:00">مساءً</button>
                </div>
                <div class="day-chips">
                    <button type="button" class="btn btn-ghost day-chip" data-days="0">اليوم</button>
                    <button type="button" class="btn btn-ghost day-chip" data-days="1">بكره</button>
                    <button type="button" class="btn btn-ghost day-chip" data-days="2">بعد بكره</button>
                </div>
            }
            <label>المدة المتوقعة</label>
            <select name="duration">
                <option value="">—</option>
                <option value="30">30 دقيقة</option>
                <option value="60">60 دقيقة</option>
            </select>
            <label>2 — @L.T("ViewingMessage")</label>
            <textarea name="message" rows="2" maxlength="500"></textarea>
            <button type="submit" class="btn btn-primary">3 — @L.T("BookViewing")</button>
        </form>
    </section>
    </details>
}

@if (ViewBag.SimilarPrices is System.Collections.Generic.IEnumerable<dynamic> similarPrices && similarPrices.Any())
{
    <section>
        <h2>أسعار مشابهة في @Model.Area</h2>
        <ul class="similar-prices">
            @foreach (var item in similarPrices)
            {
                <li><a asp-action="Details" asp-route-id="@item.Id">@item.Title</a> — @L.PriceText((decimal)item.Price, Model.ListingType)@(item.AreaSqm > 0 ? $" • {item.AreaSqm} م²" : "")</li>
            }
        </ul>
    </section>
}

@{
    var similar = ViewBag.SimilarListings as List<Listing>;
}
@if (similar != null && similar.Any())
{
    <section>
        <h2>@L.T("SimilarListings") (@similar.Count)</h2>
        <div class="cards-slider similar-compact">
            @foreach (var item in similar)
            {
                @await Html.PartialAsync("_ListingCard", item)
            }
        </div>
    </section>
}

@* Batch 20 — design 2 (8): شريط تواصل ثابت في الموبايل. *@
@if (Model.IsAvailable)
{
    <div class="sticky-contact">
        <span class="sticky-price">@L.PriceText(Model.Price, Model.ListingType)</span>
        @if (Model.ListingType == ListingType.Sale)
        {
            <a class="btn btn-primary" asp-controller="Contact" asp-action="Contact" asp-route-listingId="@Model.Id" asp-route-intent="buy">@L.T("Buy")</a>
        }
        else
        {
            <a class="btn btn-primary" asp-controller="Contact" asp-action="Contact" asp-route-listingId="@Model.Id" asp-route-intent="rent">@L.T("RentIt")</a>
        }
        <a class="btn btn-primary sticky-whatsapp" href="https://wa.me/@ContactOptions.Value.WhatsAppDigits?text=@Uri.EscapeDataString($"بخصوص الإعلان {Model.AdNumber}")" target="_blank" rel="noopener">💬 واتساب</a>
        <a class="btn btn-ghost" href="tel:@ContactOptions.Value.Phone">📞 @L.T("CallUs")</a>
    </div>
}


<nav class="details-nav">
    @if (ViewBag.PreviousListing != null)
    {
        <a class="btn btn-ghost" asp-action="Details" asp-route-id="@ViewBag.PreviousListing.Id">← الإعلان السابق: @ViewBag.PreviousListing.Title</a>
    }
    @if (ViewBag.NextListing != null)
    {
        <a class="btn btn-ghost" asp-action="Details" asp-route-id="@ViewBag.NextListing.Id">الإعلان التالي: @ViewBag.NextListing.Title →</a>
    }
</nav>
