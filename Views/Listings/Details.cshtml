@model Listing
<h1>@Model.Title</h1>
<div class="listing-meta">
    <span class="badge @(Model.ListingType == ListingType.Sale ? "badge-sale" : "badge-rent")">@L.ListingTypeText(Model.ListingType)</span>
    <span class="badge">@L.PropertyTypeText(Model.PropertyType)</span>
    <span class="ad-number">@L.T("AdNumber"): @Model.AdNumber</span>
    <span class="listing-status @(Model.IsAvailable ? "available" : "closed")">@(Model.IsAvailable ? L.T("Available") : L.T("NotAvailable"))</span>
</div>

@{
    var photos = Model.Attachments.Where(a => a.Kind == AttachmentKind.Photo).OrderBy(a => a.Order).ThenBy(a => a.Id).ToList();
    var video = Model.Attachments.FirstOrDefault(a => a.Kind == AttachmentKind.Video);
}
@if (photos.Any())
{
    <div class="gallery">
        @foreach (var photo in photos)
        {
            <img class="detail-photo" src="/@photo.FilePath" alt="@Model.Title" />
        }
    </div>
}
else
{
    <div class="detail-photo placeholder">@L.T("NoPhoto")</div>
}
@if (video != null)
{
    <video class="detail-video" controls src="/@video.FilePath"></video>
}

<p><strong>@L.T("Area"):</strong> @Model.Area</p>
<p><strong>@L.T("AreaSqm"):</strong> @Model.AreaSqm</p>
<p><strong>@L.T("Price"):</strong> @L.PriceText(Model.Price, Model.ListingType)</p>
<p><strong>@L.T("Views"):</strong> @Model.ViewCount</p>
@if (User.IsInRole("Admin"))
{
    <h2>@L.T("AdvertiserData")</h2>
    <p><strong>@L.T("FullName"):</strong> @(Model.Owner?.FullName ?? "-")</p>
    <p><strong>@L.T("PhoneNumber"):</strong> @(Model.Owner?.PhoneNumber ?? "-")</p>
    <p><strong>@L.T("Address"):</strong> @(Model.Owner?.Address ?? "-")</p>
    @if (!string.IsNullOrWhiteSpace(Model.DetailedAddress))
    {
        <p><strong>العنوان التفصيلي للعقار (للأدمن فقط):</strong> @Model.DetailedAddress</p>
    }
    <p><strong>@L.T("ApprovalStatus"):</strong> @L.ApprovalText(Model.Approval)</p>
}

<h2>@L.T("Details")</h2>
<p>@Model.Description</p>

@if (Model.FeaturesList.Any())
{
    <h2>@L.T("Features")</h2>
    <ul>
        @foreach (var feature in Model.FeaturesList)
        {
            <li>@feature</li>
        }
    </ul>
}

<div class="actions">
    @if (Model.IsAvailable)
    {
        @if (Model.ListingType == ListingType.Sale)
        {
            <a class="btn btn-primary" asp-controller="Contact" asp-action="Contact" asp-route-listingId="@Model.Id" asp-route-intent="buy">@L.T("Buy")</a>
        }
        else
        {
            <a class="btn btn-primary" asp-controller="Contact" asp-action="Contact" asp-route-listingId="@Model.Id" asp-route-intent="rent">@L.T("RentIt")</a>
        }
        <a class="btn btn-ghost" asp-controller="Contact" asp-action="Contact" asp-route-listingId="@Model.Id">@L.T("ContactUs")</a>
    }
    @if (User.Identity?.IsAuthenticated == true && (Model.OwnerId == User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value || User.IsInRole("Admin")))
    {
        <a class="btn btn-ghost" asp-action="Edit" asp-route-id="@Model.Id">@L.T("Edit")</a>
        <a class="btn btn-ghost" asp-action="Delete" asp-route-id="@Model.Id">@L.T("Delete")</a>
    }
    <a class="btn btn-ghost" asp-action="Index">@L.T("BackToList")</a>
</div>
