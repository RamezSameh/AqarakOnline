@model List<SavedSearch>
@{
    var matchCounts = ViewBag.MatchCounts as Dictionary<int, int> ?? new Dictionary<int, int>();
}
<h1>@L.T("SavedSearches")</h1>
@if (!Model.Any())
{
    <p>@L.T("NoSavedSearches")</p>
    <a class="btn btn-primary" asp-controller="Listings" asp-action="Index">@L.T("Listings")</a>
}
else
{
    <div class="saved-searches">
        @foreach (var saved in Model)
        {
            var priceText = (saved.MinPrice.HasValue || saved.MaxPrice.HasValue)
                ? $"{saved.MinPrice?.ToString("N0") ?? "…"} - {saved.MaxPrice?.ToString("N0") ?? "…"}"
                : "-";
            var areaText = (saved.MinAreaSqm.HasValue || saved.MaxAreaSqm.HasValue)
                ? $"{saved.MinAreaSqm?.ToString() ?? "…"} - {saved.MaxAreaSqm?.ToString() ?? "…"}"
                : "-";
            <article class="saved-search-card">
                <h3>@(string.IsNullOrWhiteSpace(saved.Search) ? L.T("All") : saved.Search)</h3>
                <p>@L.T("Area"): @(saved.Area ?? "-")</p>
                <p>@L.T("ListingType"): @(saved.ListingType.HasValue ? L.ListingTypeText(saved.ListingType.Value) : "-")</p>
                <p>@L.T("Price"): @priceText</p>
                <p>@L.T("AreaSqm"): @areaText</p>
                <p><strong>@L.T("MatchingNow"): @(matchCounts.TryGetValue(saved.Id, out var count) ? count : 0)</strong></p>
                <div class="actions">
                    <a class="btn btn-primary run-search-btn" asp-action="Run" asp-route-id="@saved.Id">@L.T("RunSearch")</a>
                    <form asp-action="Delete" method="post" class="inline-form">
                        <input type="hidden" name="id" value="@saved.Id" />
                        <button type="submit" class="btn btn-ghost">@L.T("Delete")</button>
                    </form>
                </div>
            </article>
        }
    </div>
    <p><small>لما ينزل إعلان جديد مطابق لأي بحث محفوظ، بيوصلك تنبيه في الجرس.</small></p>
}
