@model IEnumerable<ContactRequest>
<h1>@L.T("AdminRequests")</h1>
<form class="filter-form" asp-action="Requests" method="get">
    <input type="text" name="search" value="@ViewBag.Search" placeholder="@L.T("SearchPlaceholder")" />
    <button type="submit" class="btn btn-primary">@L.T("Filter")</button>
    <a class="btn btn-ghost" asp-action="Requests">@L.T("ClearFilter")</a>
</form>
@if (!Model.Any())
{
    <p>@L.T("NoResults")</p>
}
else
{
    <div class="requests-list">
        @foreach (var request in Model)
        {
            var digits = new string((request.BuyerPhone ?? string.Empty).Where(char.IsDigit).ToArray());
            var waUrl = $"https://wa.me/{digits}?text={Uri.EscapeDataString($"مرحبًا {request.BuyerName}، بخصوص الإعلان رقم {request.Listing?.AdNumber}")}";
            <article class="request-card @(request.IsReplied ? "replied" : "unreplied")">
                <p><strong>@request.Listing?.AdNumber</strong> — @request.CreatedAt.ToString("yyyy-MM-dd HH:mm")</p>
                <p>@request.BuyerName — @request.BuyerPhone</p>
                <p>@L.IntentText(request.Intent)</p>
                <p>@request.Message</p>
                <div class="actions">
                    <a class="btn btn-ghost" href="@waUrl" target="_blank" rel="noreferrer">@L.T("OpenWhatsApp")</a>
                    @if (request.IsReplied)
                    {
                        <span>@L.T("Replied")</span>
                    }
                    else
                    {
                        <form asp-action="MarkReplied" method="post" class="inline-form">
                            <input type="hidden" name="id" value="@request.Id" />
                            <button type="submit" class="btn btn-primary">@L.T("MarkReplied")</button>
                        </form>
                    }
                </div>
            </article>
        }
    </div>
}
