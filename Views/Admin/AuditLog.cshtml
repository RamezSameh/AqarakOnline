@model IEnumerable<ListingAudit>
@{
    var listing = (Listing)ViewBag.Listing;
}
<h1>@L.T("AuditLog")</h1>
<p>الإعلان: <a asp-controller="Listings" asp-action="Details" asp-route-id="@listing.Id">@listing.AdNumber — @listing.Title</a></p>

@if (!Model.Any())
{
    <p>لا توجد تعديلات مسجلة بعد.</p>
}
else
{
    <div class="audit-timeline">
        @foreach (var audit in Model)
        {
            <div class="audit-item">
                <strong>@audit.Action</strong>
                <p>@(audit.Details ?? "-")</p>
                <p><small>@audit.UserName • @L.RelativeTime(audit.CreatedAt)</small></p>
            </div>
        }
    </div>
}

<p><a class="btn btn-ghost" asp-action="Listings">رجوع للإعلانات</a></p>
