@model AqarakOnline.Controllers.AdminUserFormViewModel
<h1>تعديل حساب مستخدم</h1>
<form asp-action="EditUser" method="post" class="form">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
    <label>الاسم (عربي أو إنجليزي)</label>
    <input asp-for="FullName" />
    <span asp-validation-for="FullName" class="field-error"></span>
    <label>العنوان</label>
    <input asp-for="Address" />
    <span asp-validation-for="Address" class="field-error"></span>
    <label>رقم الموبايل (11 رقمًا بالضبط، يبدأ بـ 01)</label>
    <input asp-for="PhoneNumber" type="tel" dir="ltr" placeholder="01xxxxxxxxx" />
    <span asp-validation-for="PhoneNumber" class="field-error"></span>
    <label>البريد الإلكتروني (اختياري)</label>
    <input asp-for="Email" type="email" />
    <span asp-validation-for="Email" class="field-error"></span>
    <label>كلمة مرور جديدة (اتركها فارغة للإبقاء على الحالية)</label>
    <input asp-for="Password" type="password" />
    <span asp-validation-for="Password" class="field-error"></span>
    <label>الدور</label>
    <select asp-for="Role">
        <option value="User">مستخدم</option>
        <option value="Admin">أدمن</option>
    </select>
    <label>حالة الحساب</label>
    <select asp-for="AccountStatus">
        <option value="Pending">قيد المراجعة</option>
        <option value="Active">مفعَّل</option>
        <option value="Suspended">موقوف مؤقتًا</option>
        <option value="Blocked">محظور</option>
    </select>
    <div class="actions">
        <button type="submit" class="btn btn-primary">حفظ التعديلات</button>
        <a class="btn btn-ghost" asp-action="Users">إلغاء</a>
    </div>
</form>
