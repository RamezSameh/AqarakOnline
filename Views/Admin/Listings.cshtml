@model IEnumerable<Listing>
<h1>@L.T("AdminListings")</h1>
<p>بيانات المعلن تظهر هنا للأدمن فقط، ولا تظهر في صفحة الإعلان العامة.</p>
<p><a class="btn btn-primary" asp-action="ExportListings">⬇ @L.T("ExportListings")</a> <a class="btn btn-primary" asp-action="ImportListings">⬆ @L.T("ImportListings")</a></p>
<form class="filter-form" asp-action="Listings" method="get">
    <input type="text" name="search" value="@ViewBag.Search" placeholder="@L.T("SearchPlaceholder")" />
    <label class="sort-label">
        الحالة
        <select name="approval">
            <option value="" selected="@(string.IsNullOrWhiteSpace(ViewBag.Approval))">الكل</option>
            <option value="Approved" selected="@(ViewBag.Approval == "Approved")">مقبول</option>
            <option value="Pending" selected="@(ViewBag.Approval == "Pending")">معلّق</option>
            <option value="Rejected" selected="@(ViewBag.Approval == "Rejected")">مرفوض</option>
        </select>
    </label>
    <label class="sort-label">
        نوع العقار
        <select name="propertyType">
            <option value="" selected="@(string.IsNullOrWhiteSpace(ViewBag.PropertyType))">الكل</option>
            @foreach (PropertyType pt in Enum.GetValues(typeof(PropertyType)))
            {
                <option value="@pt" selected="@(ViewBag.PropertyType == pt.ToString())">@L.PropertyTypeText(pt)</option>
            }
        </select>
    </label>
    <button type="submit" class="btn btn-primary">@L.T("Filter")</button>
</form>
@if (!Model.Any())
{
    <p>@L.T("NoResults")</p>
}
else
{
    <div class="admin-cards">
        @foreach (var listing in Model)
        {
            <article class="admin-card admin-listing-card">
                <h3><a asp-controller="Listings" asp-action="Details" asp-route-id="@listing.Id">@listing.Title</a></h3>
                <p><strong>@listing.AdNumber</strong> • @L.ListingTypeText(listing.ListingType) • @L.PriceText(listing.Price, listing.ListingType)</p>
                <p>@(listing.Owner?.FullName ?? listing.Owner?.UserName ?? listing.GuestName ?? L.T("SiteAdmin")) — @(listing.Owner?.PhoneNumber ?? listing.GuestPhone ?? "-") — @(listing.Owner?.Address ?? "-")</p>
                <p>@L.ApprovalText(listing.Approval) • @(listing.IsEffectivelyFeatured ? "⭐" : "-")
                    @if (listing.FeaturedUntil.HasValue && listing.IsFeatured)
                    {
                        <small>@L.T("FeaturedUntil") @listing.FeaturedUntil.Value.ToLocalTime().ToString("dd/MM/yyyy")</small>
                    }
                </p>
                <div class="actions">
                    <form asp-action="SetFeatured" method="post" class="inline-form">
                        <input type="hidden" name="id" value="@listing.Id" />
                        @if (listing.IsEffectivelyFeatured)
                        {
                            <button type="submit" class="btn btn-ghost">@L.T("UnmarkFeatured")</button>
                        }
                        else
                        {
                            <div class="filter-chips">
                                <label class="filter-chip"><input type="radio" name="days" value="7" checked /> 7 أيام</label>
                                <label class="filter-chip"><input type="radio" name="days" value="14" /> 14 يومًا</label>
                                <label class="filter-chip"><input type="radio" name="days" value="30" /> 30 يومًا</label>
                            </div>
                            <button type="submit" class="btn btn-primary">@L.T("MarkFeatured")</button>
                        }
                    </form>
                    @if (listing.Approval == ListingApproval.Pending)
                    {
                        <form asp-action="Approve" method="post" class="inline-form">
                            <input type="hidden" name="id" value="@listing.Id" />
                            <button type="submit" class="btn btn-primary">@L.T("Approve")</button>
                        </form>
                        <form asp-action="Reject" method="post" class="inline-form">
                            <input type="hidden" name="id" value="@listing.Id" />
                            <input type="text" name="reason" placeholder="@L.T("RejectionReason")" maxlength="500" />
                            <button type="submit" class="btn btn-ghost">@L.T("Reject")</button>
                        </form>
                    }
                    @if (listing.IsAvailable)
                    {
                        <form asp-controller="Listings" asp-action="MarkUnavailable" method="post" class="inline-form">
                            <input type="hidden" name="id" value="@listing.Id" />
                            <button type="submit" class="btn btn-ghost">@L.T("MarkUnavailable")</button>
                        </form>
                    }
                    else
                    {
                        <form asp-controller="Listings" asp-action="MarkAvailable" method="post" class="inline-form">
                            <input type="hidden" name="id" value="@listing.Id" />
                            <button type="submit" class="btn btn-ghost">@L.T("MarkAvailable")</button>
                        </form>
                    }
                    <a class="btn btn-ghost" asp-controller="Listings" asp-action="Delete" asp-route-id="@listing.Id">@L.T("Delete")</a>
                    <a class="btn btn-ghost" asp-action="AuditLog" asp-route-listingId="@listing.Id">@L.T("AuditLog")</a>
                </div>
            </article>
        }
    </div>
}
