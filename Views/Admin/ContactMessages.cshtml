@model IEnumerable<ContactMessage>
<h1>@L.T("ContactMessages")</h1>
@if (!Model.Any())
{
    <p>لا توجد رسائل.</p>
}
else
{
    <div class="admin-cards">
        @foreach (var message in Model)
        {
            <article class="admin-card message-card @(message.IsRead ? "read" : "unread")">
                <h3>@message.Name — @message.Phone</h3>
                <p>@message.Message</p>
                <p><small>@L.RelativeTime(message.CreatedAt)</small></p>
                <div class="actions">
                    @if (!message.IsRead)
                    {
                        <form asp-action="MarkMessageRead" method="post" class="inline-form">
                            <input type="hidden" name="id" value="@message.Id" />
                            <button type="submit" class="btn btn-ghost">@L.T("MarkAsRead")</button>
                        </form>
                    }
                    else
                    {
                        <span>✓</span>
                    }
                </div>
            </article>
        }
    </div>
}
