@model IEnumerable<AqarakOnline.Controllers.AdminUserRow>
<h1>المستخدمون</h1>
<p>الحساب الجديد لا يدخل حتى يوافق عليه الأدمن. من هنا يمكنك الموافقة، أو إيقاف حساب مؤقتًا، أو حظره، أو إضافة حساب جديد، أو تعديل حساب موجود، أو حذف حساب نهائيًا (مع إعلاناته وطلبات تواصله). لا يمكنك حذف حسابك أنت.</p>
<div class="actions">
    <a class="btn btn-primary" asp-action="AddUser">إضافة حساب مستخدم</a>
    <a class="btn btn-ghost" asp-action="Dashboard">لوحة التحكم</a>
    <a class="btn btn-ghost" asp-action="BlockedPhones">@L.T("BlockedPhones")</a>
</div>
<form class="filter-form" asp-action="Users" method="get">
    <input type="text" name="search" value="@ViewBag.Search" placeholder="@L.T("SearchUsersPlaceholder")" />
    <label class="sort-label">
        الحالة
        <select name="status">
            <option value="" selected="@(string.IsNullOrWhiteSpace(ViewBag.Status))">الكل</option>
            <option value="Pending" selected="@(ViewBag.Status == "Pending")">معلّق</option>
            <option value="Active" selected="@(ViewBag.Status == "Active")">مفعّل</option>
            <option value="Suspended" selected="@(ViewBag.Status == "Suspended")">موقوف</option>
            <option value="Blocked" selected="@(ViewBag.Status == "Blocked")">محظور</option>
        </select>
    </label>
    <button type="submit" class="btn btn-primary">@L.T("Search")</button>
    <a class="btn btn-ghost" asp-action="Users">@L.T("ClearFilter")</a>
</form>
@if (!Model.Any())
{
    <p>لا يوجد مستخدمون بعد.</p>
}
else
{
    <div class="admin-cards">
        @foreach (var row in Model)
        {
            <article class="admin-card user-card">
                <h3>@(row.User.FullName ?? row.User.UserName)</h3>
                @if (row.IsAdmin)
                {
                    <span class="admin-badge">👑 أدمن</span>
                }
                <p>@row.User.PhoneNumber</p>
                <p>@(row.User.Email ?? "-")</p>
                <p>@row.Role • @row.User.AccountStatus</p>
                <p>@row.ListingsCount (مقبول: @row.ApprovedListingsCount، قيد المراجعة: @row.PendingListingsCount)</p>
                <div class="actions">
                    @if (row.User.AccountStatus == AccountStatus.Pending)
                    {
                        <form asp-action="ApproveUser" method="post" class="inline-form">
                            <input type="hidden" name="id" value="@row.User.Id" />
                            <button type="submit" class="btn btn-primary">موافقة وتفعيل</button>
                        </form>
                    }
                    @if (row.User.AccountStatus == AccountStatus.Active)
                    {
                        <form asp-action="SuspendUser" method="post" class="inline-form">
                            <input type="hidden" name="id" value="@row.User.Id" />
                            <button type="submit" class="btn btn-ghost">إيقاف مؤقت</button>
                        </form>
                        <form asp-action="BlockUser" method="post" class="inline-form">
                            <input type="hidden" name="id" value="@row.User.Id" />
                            <button type="submit" class="btn btn-ghost">حظر</button>
                        </form>
                    }
                    @if (row.User.AccountStatus == AccountStatus.Suspended)
                    {
                        <form asp-action="UnsuspendUser" method="post" class="inline-form">
                            <input type="hidden" name="id" value="@row.User.Id" />
                            <button type="submit" class="btn btn-primary">إعادة تفعيل</button>
                        </form>
                        <form asp-action="BlockUser" method="post" class="inline-form">
                            <input type="hidden" name="id" value="@row.User.Id" />
                            <button type="submit" class="btn btn-ghost">حظر</button>
                        </form>
                    }
                    @if (row.User.AccountStatus == AccountStatus.Blocked)
                    {
                        <form asp-action="UnblockUser" method="post" class="inline-form">
                            <input type="hidden" name="id" value="@row.User.Id" />
                            <button type="submit" class="btn btn-primary">رفع الحظر</button>
                        </form>
                    }
                    <form asp-action="ResetPassword" method="post" class="inline-form" onsubmit="return confirm('إعادة تعيين كلمة مرور هذا المستخدم لكلمة مؤقتة؟');">
                        <input type="hidden" name="id" value="@row.User.Id" />
                        <button type="submit" class="btn btn-ghost">@L.T("ResetPassword")</button>
                    </form>
                    <a class="btn btn-ghost" asp-action="EditUser" asp-route-id="@row.User.Id">تعديل</a>
                    @if (!row.IsAdmin)
                    {
                        <form asp-action="PromoteToAdmin" method="post" class="inline-form" onsubmit="return confirm('ترقية هذا المستخدم لدور أدمن؟');">
                            <input type="hidden" name="id" value="@row.User.Id" />
                            <button type="submit" class="btn btn-ghost">ترقية لأدمن</button>
                        </form>
                    }
                    else
                    {
                        <form asp-action="DemoteFromAdmin" method="post" class="inline-form" onsubmit="return confirm('سحب دور الأدمن من هذا المستخدم؟');">
                            <input type="hidden" name="id" value="@row.User.Id" />
                            <button type="submit" class="btn btn-ghost">سحب دور الأدمن</button>
                        </form>
                    }
                    <form asp-action="DeleteUser" method="post" class="inline-form" onsubmit="return confirm('حذف هذا الحساب نهائيًا مع إعلاناته وطلبات تواصله؟ لا يمكن التراجع.');">
                        <input type="hidden" name="id" value="@row.User.Id" />
                        <button type="submit" class="btn btn-ghost">حذف نهائي</button>
                    </form>
                </div>
            </article>
        }
    </div>
}
