@model IEnumerable<AqarakOnline.Controllers.AdminUserRow>
<h1>المستخدمون</h1>
<p>الحساب الجديد لا يدخل حتى يوافق عليه الأدمن. من هنا يمكنك الموافقة، أو إيقاف حساب مؤقتًا، أو حظره، أو إضافة حساب جديد، أو تعديل حساب موجود.</p>
<div class="actions">
    <a class="btn btn-primary" asp-action="AddUser">إضافة حساب مستخدم</a>
    <a class="btn btn-ghost" asp-action="Dashboard">لوحة التحكم</a>
</div>
@if (!Model.Any())
{
    <p>لا يوجد مستخدمون بعد.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>الاسم</th>
                <th>رقم الموبايل</th>
                <th>البريد الإلكتروني</th>
                <th>الدور</th>
                <th>حالة الحساب</th>
                <th>عدد الإعلانات</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Model)
            {
                <tr>
                    <td>@(row.User.FullName ?? row.User.UserName)</td>
                    <td>@row.User.PhoneNumber</td>
                    <td>@(row.User.Email ?? "-")</td>
                    <td>@row.Role</td>
                    <td>@row.User.AccountStatus</td>
                    <td>@row.ListingsCount (مقبول: @row.ApprovedListingsCount، قيد المراجعة: @row.PendingListingsCount)</td>
                    <td>
                        @if (row.User.AccountStatus == AccountStatus.Pending)
                        {
                            <form asp-action="ApproveUser" method="post" class="inline-form">
                                <input type="hidden" name="id" value="@row.User.Id" />
                                <button type="submit" class="btn btn-primary">موافقة وتفعيل</button>
                            </form>
                        }
                        @if (row.User.AccountStatus == AccountStatus.Active)
                        {
                            <form asp-action="SuspendUser" method="post" class="inline-form">
                                <input type="hidden" name="id" value="@row.User.Id" />
                                <button type="submit" class="btn btn-ghost">إيقاف مؤقت</button>
                            </form>
                            <form asp-action="BlockUser" method="post" class="inline-form">
                                <input type="hidden" name="id" value="@row.User.Id" />
                                <button type="submit" class="btn btn-ghost">حظر</button>
                            </form>
                        }
                        @if (row.User.AccountStatus == AccountStatus.Suspended)
                        {
                            <form asp-action="UnsuspendUser" method="post" class="inline-form">
                                <input type="hidden" name="id" value="@row.User.Id" />
                                <button type="submit" class="btn btn-primary">إعادة تفعيل</button>
                            </form>
                            <form asp-action="BlockUser" method="post" class="inline-form">
                                <input type="hidden" name="id" value="@row.User.Id" />
                                <button type="submit" class="btn btn-ghost">حظر</button>
                            </form>
                        }
                        @if (row.User.AccountStatus == AccountStatus.Blocked)
                        {
                            <form asp-action="UnblockUser" method="post" class="inline-form">
                                <input type="hidden" name="id" value="@row.User.Id" />
                                <button type="submit" class="btn btn-primary">رفع الحظر</button>
                            </form>
                        }
                        <a class="btn btn-ghost" asp-action="EditUser" asp-route-id="@row.User.Id">تعديل</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
