@model AqarakOnline.Controllers.AdminDashboardViewModel
<h1>لوحة التحكم</h1>
<p><a class="btn btn-ghost" asp-action="ExportBackup">⬇ @L.T("DownloadBackup")</a></p>
<p>تحليل بيانات المنصة: المستخدمون، وعدد الإعلانات لكل مستخدم، مع فلترة حسب المستخدم أو المنطقة.</p>

<div class="cards-grid">
    <div class="listing-card"><div class="listing-body"><h3>المستخدمون</h3><p>@Model.TotalUsers</p><p>قيد المراجعة: @Model.PendingUsers | مفعّلون: @Model.ActiveUsers | موقوفون/محظورون: @Model.SuspendedOrBlockedUsers</p></div></div>
    <div class="listing-card"><div class="listing-body"><h3>الإعلانات</h3><p>@Model.TotalListings</p><p>مقبول: @Model.ApprovedListings | قيد المراجعة: @Model.PendingListings | متاح: @Model.AvailableListings</p></div></div>
    <div class="listing-card"><div class="listing-body"><h3>المشاهدات وطلبات التواصل</h3><p>مشاهدات: @Model.TotalViews</p><p>طلبات تواصل: @Model.TotalRequests | غير مردود عليها: @Model.UnrepliedRequests</p></div></div>
</div>

<h2>فلترة</h2>
<form asp-action="Dashboard" method="get" class="form">
    <label>المستخدم</label>
    <select name="userId">
        <option value="">كل المستخدمين</option>
        @foreach (var user in Model.Users)
        {
            <option value="@user.Id" selected="@(Model.FilterUserId == user.Id ? "selected" : null)">@(user.FullName ?? user.UserName) (@user.PhoneNumber)</option>
        }
    </select>
    <label>المنطقة</label>
    <select name="area">
        <option value="">كل المناطق</option>
        @foreach (var area in Model.Areas)
        {
            <option value="@area" selected="@(Model.FilterArea == area ? "selected" : null)">@area</option>
        }
    </select>
    <div class="actions">
        <button type="submit" class="btn btn-primary">فلترة</button>
        <a class="btn btn-ghost" asp-action="Dashboard">مسح الفلترة</a>
    </div>
</form>

<h2>عدد الإعلانات لكل مستخدم</h2>
@if (!Model.UserRows.Any())
{
    <p>لا توجد نتائج مطابقة للفلترة.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>المستخدم</th>
                <th>رقم الموبايل</th>
                <th>حالة الحساب</th>
                <th>عدد الإعلانات</th>
                <th>مقبول</th>
                <th>قيد المراجعة</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Model.UserRows)
            {
                <tr>
                    <td>@(row.User.FullName ?? row.User.UserName)</td>
                    <td>@row.User.PhoneNumber</td>
                    <td>@row.User.AccountStatus</td>
                    <td>@row.ListingsCount</td>
                    <td>@row.ApprovedListingsCount</td>
                    <td>@row.PendingListingsCount</td>
                </tr>
            }
        </tbody>
    </table>
}

<h2>الإعلانات المطابقة للفلترة</h2>
@if (!Model.FilteredListings.Any())
{
    <p>لا توجد إعلانات مطابقة للفلترة.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>رقم الإعلان</th>
                <th>العنوان</th>
                <th>المعلن</th>
                <th>المنطقة</th>
                <th>حالة النشر</th>
                <th>السعر</th>
                <th>المشاهدات</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var listing in Model.FilteredListings)
            {
                <tr>
                    <td>@listing.AdNumber</td>
                    <td><a asp-controller="Listings" asp-action="Details" asp-route-id="@listing.Id">@listing.Title</a></td>
                    <td>@(listing.Owner?.FullName ?? listing.Owner?.UserName ?? "إدارة الموقع")</td>
                    <td>@listing.Area</td>
                    <td>@listing.Approval</td>
                    <td>@listing.Price</td>
                    <td>@listing.ViewCount</td>
                </tr>
            }
        </tbody>
    </table>
}

<h2>إعلانات قديمة (أكثر من 30 يومًا، مقبولة ومتاحة)</h2>
@if (!Model.StaleListings.Any())
{
    <p>لا توجد إعلانات قديمة.</p>
}
else
{
    <p>عددها: @Model.StaleListings.Count — راجعها مع أصحابها: حدّث السعر أو أغلقها لو اتباعت.</p>
    <table class="table">
        <thead>
            <tr>
                <th>رقم الإعلان</th>
                <th>العنوان</th>
                <th>المعلن</th>
                <th>المنطقة</th>
                <th>تاريخ النشر</th>
                <th>المشاهدات</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var listing in Model.StaleListings)
            {
                <tr>
                    <td>@listing.AdNumber</td>
                    <td><a asp-controller="Listings" asp-action="Details" asp-route-id="@listing.Id">@listing.Title</a></td>
                    <td>@(listing.Owner?.FullName ?? listing.Owner?.UserName ?? "إدارة الموقع")</td>
                    <td>@listing.Area</td>
                    <td>@L.RelativeTime(listing.CreatedAt)</td>
                    <td>@listing.ViewCount</td>
                </tr>
            }
        </tbody>
    </table>
}

<h2>إعلانات معلّقة منذ أكثر من 3 أيام</h2>
@if (!Model.StalePendingListings.Any())
{
    <p>لا توجد إعلانات معلّقة قديمة.</p>
}
else
{
    <p>عددها: @Model.StalePendingListings.Count — تحتاج قرار موافقة أو رفض من صفحة الإعلانات.</p>
    <table class="table">
        <thead>
            <tr>
                <th>رقم الإعلان</th>
                <th>العنوان</th>
                <th>المعلن</th>
                <th>المنطقة</th>
                <th>تاريخ النشر</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var listing in Model.StalePendingListings)
            {
                <tr>
                    <td>@listing.AdNumber</td>
                    <td><a asp-controller="Listings" asp-action="Details" asp-route-id="@listing.Id">@listing.Title</a></td>
                    <td>@(listing.Owner?.FullName ?? listing.Owner?.UserName ?? "إدارة الموقع")</td>
                    <td>@listing.Area</td>
                    <td>@L.RelativeTime(listing.CreatedAt)</td>
                </tr>
            }
        </tbody>
    </table>
}

<h2>طلبات اتصال لم يُرد عليها منذ أكثر من 48 ساعة</h2>
@if (!Model.StaleRequests.Any())
{
    <p>لا توجد طلبات متأخرة.</p>
}
else
{
    <p>عددها: @Model.StaleRequests.Count — رد عليها من صفحة طلبات التواصل.</p>
    <table class="table">
        <thead>
            <tr>
                <th>الاسم</th>
                <th>الهاتف</th>
                <th>الإعلان</th>
                <th>التاريخ</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var contactRequest in Model.StaleRequests)
            {
                <tr>
                    <td>@contactRequest.BuyerName</td>
                    <td>@contactRequest.BuyerPhone</td>
                    <td><a asp-controller="Listings" asp-action="Details" asp-route-id="@contactRequest.ListingId">@(contactRequest.Listing?.Title ?? "-")</a></td>
                    <td>@L.RelativeTime(contactRequest.CreatedAt)</td>
                </tr>
            }
        </tbody>
    </table>
}

<h2>إعلانات تحتاج تجديد (أكثر من 60 يومًا)</h2>
@if (!Model.RenewalListings.Any())
{
    <p>لا توجد إعلانات تحتاج تجديد.</p>
}
else
{
    <p>عددها: @Model.RenewalListings.Count — دوس الزرار يبعت تنبيه «جدّد إعلانك» لأصحابها (مرة كل 60 يومًا لكل إعلان).</p>
    <form asp-action="SendRenewalReminders" method="post" class="inline-form">
        <button type="submit" class="btn btn-primary">إرسال تنبيهات التجديد</button>
    </form>
    <table class="table">
        <thead>
            <tr>
                <th>رقم الإعلان</th>
                <th>العنوان</th>
                <th>المعلن</th>
                <th>المنطقة</th>
                <th>تاريخ النشر</th>
                <th>المشاهدات</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var listing in Model.RenewalListings)
            {
                <tr>
                    <td>@listing.AdNumber</td>
                    <td><a asp-controller="Listings" asp-action="Details" asp-route-id="@listing.Id">@listing.Title</a></td>
                    <td>@(listing.Owner?.FullName ?? listing.Owner?.UserName ?? "إدارة الموقع")</td>
                    <td>@listing.Area</td>
                    <td>@L.RelativeTime(listing.CreatedAt)</td>
                    <td>@listing.ViewCount</td>
                </tr>
            }
        </tbody>
    </table>
}

<h2>إحصائيات</h2>
@{
    var maxMonthly = Model.MonthlyListings.Any() ? Model.MonthlyListings.Max(p => p.Count) : 0;
    var maxArea = Model.ListingsByArea.Any() ? Model.ListingsByArea.Max(p => p.Count) : 0;
}
<h3>إعلانات جديدة — آخر 6 شهور</h3>
<div class="chart">
    @foreach (var point in Model.MonthlyListings)
    {
        var pct = maxMonthly > 0 ? point.Count * 100 / maxMonthly : 0;
        <div class="chart-row">
            <span class="chart-label">@point.Label</span>
            <div class="chart-track"><div class="chart-bar" style="width:@pct%"></div></div>
            <span class="chart-count">@point.Count</span>
        </div>
    }
</div>
<h3>الإعلانات حسب المنطقة (أعلى 8)</h3>
<div class="chart">
    @foreach (var point in Model.ListingsByArea)
    {
        var pct = maxArea > 0 ? point.Count * 100 / maxArea : 0;
        <div class="chart-row">
            <span class="chart-label">@point.Label</span>
            <div class="chart-track"><div class="chart-bar" style="width:@pct%"></div></div>
            <span class="chart-count">@point.Count</span>
        </div>
    }
</div>
<h3>أكثر الإعلانات مشاهدة</h3>
@if (!Model.TopViewed.Any())
{
    <p>لا توجد مشاهدات بعد.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>العنوان</th>
                <th>المنطقة</th>
                <th>المشاهدات</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var listing in Model.TopViewed)
            {
                <tr>
                    <td><a asp-controller="Listings" asp-action="Details" asp-route-id="@listing.Id">@listing.Title</a></td>
                    <td>@listing.Area</td>
                    <td>@listing.ViewCount</td>
                </tr>
            }
        </tbody>
    </table>
}
