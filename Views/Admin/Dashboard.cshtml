<h3>@L.T("AvgPricePerSqmByArea")</h3>
@if (!Model.AreaPrices.Any())
{
    <p>لا توجد إعلانات متاحة بعد.</p>
}
else
{
    <table class="table">
        <thead><tr><th>@L.T("Area")</th><th>@L.T("AvgPricePerSqm")</th><th>@L.T("ListingsCount")</th></tr></thead>
        <tbody>
            @foreach (var p in Model.AreaPrices)
            {
                <tr><td>@p.Area</td><td>@p.AvgPricePerSqm.ToString("N0") جنيه/م²</td><td>@p.ListingsCount</td></tr>
            }
        </tbody>
    </table>
}
