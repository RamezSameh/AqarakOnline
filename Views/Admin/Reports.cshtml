@model IEnumerable<ListingReport>
<h1>@L.T("Reports")</h1>
<form class="filter-form" asp-action="Reports" method="get">
    <label class="sort-label">
        الحالة
        <select name="status">
            <option value="" selected="@(string.IsNullOrWhiteSpace(ViewBag.Status))">الكل</option>
            <option value="pending" selected="@(ViewBag.Status == "pending")">قيد المراجعة</option>
            <option value="reviewed" selected="@(ViewBag.Status == "reviewed")">تمت المراجعة</option>
        </select>
    </label>
    <button type="submit" class="btn btn-primary">@L.T("Filter")</button>
</form>
@if (!Model.Any())
{
    <p>@L.T("NoReports")</p>
}
else
{
    <div class="admin-cards">
        @foreach (var report in Model)
        {
            <article class="admin-card report-card @(report.Status == ReportStatus.Reviewed ? "reviewed" : "pending")">
                <h3>
                    @if (report.Listing != null)
                    {
                        <a asp-controller="Listings" asp-action="Details" asp-route-id="@report.ListingId">@report.Listing.Title</a>
                    }
                    else
                    {
                        <span>-</span>
                    }
                </h3>
                <p>@(report.Reason switch { ReportReason.Misleading => "🚫 ", ReportReason.WrongInfo => "❌ ", ReportReason.Scam => "⚠️ ", ReportReason.Offensive => "🔞 ", _ => "📝 " })@L.ReportReasonText(report.Reason)</p>
                <p>@(report.Details ?? "-")</p>
                <p>@(report.Reporter?.FullName ?? report.Reporter?.UserName ?? "-")</p>
                <p>@L.RelativeTime(report.CreatedAt)</p>
                <p><strong>@(report.Status == ReportStatus.Reviewed ? L.T("ReportReviewed") : L.T("ReportPending"))</strong></p>
                <div class="actions">
                    @if (report.Status == ReportStatus.Pending)
                    {
                        <form asp-action="MarkReviewed" method="post" class="inline-form">
                            <input type="hidden" name="id" value="@report.Id" />
                            <button type="submit" class="btn btn-primary">@L.T("MarkReviewed")</button>
                        </form>
                    }
                    <form asp-action="DeleteReport" method="post" class="inline-form">
                        <input type="hidden" name="id" value="@report.Id" />
                        <button type="submit" class="btn btn-ghost">@L.T("Delete")</button>
                    </form>
                </div>
            </article>
        }
    </div>
}
