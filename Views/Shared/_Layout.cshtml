@inject Microsoft.AspNetCore.Identity.UserManager<ApplicationUser> HeaderUserManager
<!DOCTYPE html>
<html lang="@L.Culture" dir="@(L.IsArabic ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@L.T("Brand") - @L.T("Tagline")</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header class="site-header">
        <div class="container header-inner">
            <a class="brand" asp-controller="Home" asp-action="Index">@L.T("Brand")</a>
            <button type="button" class="nav-toggle" id="navToggle" aria-label="القائمة" aria-expanded="false" aria-controls="mainNav">☰</button>
            <nav class="main-nav" id="mainNav">
                <a asp-controller="Home" asp-action="Index">@L.T("Home")</a>
                <a asp-controller="Listings" asp-action="Index">@L.T("Listings")</a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-controller="Listings" asp-action="MyListings">@L.T("MyListings")</a>
                    <a asp-controller="Listings" asp-action="Create">@L.T("CreateListing")</a>
                    <a asp-controller="Favorites" asp-action="Index">@L.T("Favorites")</a>
                }
                @if (User.IsInRole("Admin"))
                {
                    <a asp-controller="Admin" asp-action="Dashboard">لوحة التحكم</a>
                    <a asp-controller="Admin" asp-action="Users">المستخدمون</a>
                    <a asp-controller="Admin" asp-action="Requests">@L.T("AdminRequests")</a>
                    <a asp-controller="Admin" asp-action="Listings">@L.T("AdminListings")</a>
                    <a asp-controller="Admin" asp-action="Notifications">التنبيهات</a>
                }
            </nav>
            <div class="header-actions">
                @await Component.InvokeAsync("NotificationBell")
                <a class="lang-switch" asp-controller="Language" asp-action="Set" asp-route-lang="@(L.IsArabic ? "en" : "ar")" asp-route-returnUrl="@Context.Request.Path">@(L.IsArabic ? "English" : "العربية")</a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    @* الاسم يظهر في الـ header، وليس رقم الموبايل. *@
                    var headerUser = await HeaderUserManager.GetUserAsync(User);
                    var displayName = !string.IsNullOrWhiteSpace(headerUser?.FullName) ? headerUser!.FullName : User.Identity.Name;
                    <span class="user-name">@displayName</span>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="inline-form">
                        <button type="submit" class="btn btn-ghost">@L.T("Logout")</button>
                    </form>
                }
                else
                {
                    <a class="btn btn-ghost" asp-controller="Account" asp-action="Login">@L.T("Login")</a>
                    <a class="btn btn-primary" asp-controller="Account" asp-action="Register">@L.T("Register")</a>
                }
            </div>
        </div>
    </header>
    <main class="container main-content">
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-error">@TempData["Error"]</div>
        }
        @if (TempData["Info"] != null)
        {
            <div class="alert alert-info">@TempData["Info"]</div>
        }
        @RenderBody()
    </main>
    <footer class="site-footer">
        <div class="container">
            <p>@L.T("Brand") - @L.T("Tagline")</p>
            <p>@L.T("Phone"): @ContactOptions.Value.Phone | @L.T("WhatsApp"): @ContactOptions.Value.WhatsApp | @L.T("Email"): @ContactOptions.Value.Email</p>
        </div>
    </footer>
    <script src="~/js/site.js" defer></script>
</body>
</html>
