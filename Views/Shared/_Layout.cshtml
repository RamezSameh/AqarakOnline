@inject Microsoft.AspNetCore.Identity.UserManager<ApplicationUser> HeaderUserManager
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var headerUser = User.Identity?.IsAuthenticated == true ? await HeaderUserManager.GetUserAsync(User) : null;
    var displayName = !string.IsNullOrWhiteSpace(headerUser?.FullName) ? headerUser!.FullName : User.Identity?.Name;
}
<!DOCTYPE html>
<html lang="@L.Culture" dir="@(L.IsArabic ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@L.T("Brand") - @L.T("Tagline")</title>
    @await RenderSectionAsync("Meta", required: false)
    <meta name="theme-color" content="#111827" />
    <meta name="description" content="إعلانات عقارات للبيع والإيجار في القاهرة والجيزة — شقق، فيلات، محلات وعمارات." />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    @* الوضع الفاتح/الداكن يُطبَّق قبل رسم الصفحة حتى لا يلمع الداكن أولًا. *@
    <script>try { document.documentElement.setAttribute("data-theme", localStorage.getItem("aqarak-theme") || "dark"); } catch (e) {}</script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header class="site-header">
        <div class="container header-inner">
            <a class="brand" asp-controller="Home" asp-action="Index"><span class="brand-icon">🏠</span> @L.T("Brand")</a>
            <nav class="main-nav" id="mainNav">
                <a class="nav-link @(currentController == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index">@L.T("Home")</a>
                <a class="nav-link @(currentController == "Listings" && currentAction == "Index" ? "active" : "")" asp-controller="Listings" asp-action="Index">@L.T("Listings")</a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    @* باقي الخصائص ظاهرة عادي في الـ header على اليمين. *@
                    <a class="nav-link @(currentController == "Listings" && currentAction == "MyListings" ? "active" : "")" asp-controller="Listings" asp-action="MyListings">@L.T("MyListings")</a>
                    <a class="nav-link @(currentController == "Favorites" ? "active" : "")" asp-controller="Favorites" asp-action="Index">@L.T("Favorites")</a>
                    <a class="nav-link @(currentController == "SavedSearches" ? "active" : "")" asp-controller="SavedSearches" asp-action="Index">@L.T("SavedSearches")</a>
                    <a class="nav-link @(currentController == "Viewings" ? "active" : "")" asp-controller="Viewings" asp-action="Index">@L.T("Viewings")</a>
                    <a class="nav-link @(currentController == "Account" && currentAction == "MyAccount" ? "active" : "")" asp-controller="Account" asp-action="MyAccount">@L.T("MyAccount")</a>
                    <a class="nav-cta @(currentController == "Listings" && currentAction == "Create" ? "active" : "")" asp-controller="Listings" asp-action="Create">@L.T("CreateListing")</a>
                    @* غلاف display:contents حتى تُستبدل الإدارة لحظيًا من غير كسر توزيع الـ flex. *@
                    <span id="adminNavLinks" style="display:contents">@await Component.InvokeAsync("AdminNav")</span>
                    @* على الموبايل فقط: البروفايل وتسجيل الخروج داخل اللوحة. *@
                    <div class="panel-account mobile-only">
                        <a class="profile-link" asp-controller="Listings" asp-action="MyListings">👤 @displayName</a>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="inline-form">
                            <button type="submit" class="btn btn-ghost">@L.T("Logout")</button>
                        </form>
                    </div>
                }
                else
                {
                    <a class="nav-link @(currentController == "Favorites" ? "active" : "")" asp-controller="Favorites" asp-action="Index">@L.T("Favorites")</a>
                    <a class="btn btn-ghost nav-auth" asp-controller="Account" asp-action="Login">@L.T("Login")</a>
                    <a class="btn btn-primary nav-auth" asp-controller="Account" asp-action="Register">@L.T("Register")</a>
                }
            </nav>
            <div class="header-actions">
                <button type="button" id="themeToggle" class="btn btn-ghost" title="الوضع الفاتح / الداكن">☀️</button>
                @await Component.InvokeAsync("NotificationBell")
                <a class="lang-switch" asp-controller="Language" asp-action="Set" asp-route-lang="@(L.IsArabic ? "en" : "ar")" asp-route-returnUrl="@Context.Request.Path">@(L.IsArabic ? "English" : "العربية")</a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    @* جنب اليسار: البروفايل وتسجيل الخروج. *@
                    <a class="profile-link desktop-only" asp-controller="Listings" asp-action="MyListings">👤 @displayName</a>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="inline-form desktop-only">
                        <button type="submit" class="btn btn-ghost">@L.T("Logout")</button>
                    </form>
                }
            </div>
            <button type="button" class="nav-toggle" id="navToggle" aria-label="القائمة" aria-expanded="false" aria-controls="mainNav">☰</button>
        </div>
    </header>
    @* لوحة الإدارة الجانبية: خارج الـ header وقائمة الموبايل عمدًا حتى
       لا يخفيها قفل القائمة (display:none يخفي حتى العناصر fixed). *@
    <span id="adminSidePanel" style="display:contents">@await Component.InvokeAsync("AdminNav", new { panelOnly = true })</span>
    <main class="container main-content">
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-error">@TempData["Error"]</div>
        }
        @if (TempData["Info"] != null)
        {
            <div class="alert alert-info">@TempData["Info"]</div>
        }
        @RenderBody()
    </main>
    <footer class="site-footer">
        <div class="container">
            <p>@L.T("Brand") - @L.T("Tagline")</p>
            <p><a asp-controller="Home" asp-action="Contact">@L.T("ContactUs")</a> | <a asp-controller="Home" asp-action="SellGuide">@L.T("SellGuide")</a> | <a asp-controller="Home" asp-action="Tips">@L.T("Tips")</a> | <a asp-controller="Home" asp-action="PriceGuide">@L.T("PriceGuide")</a> | <a asp-controller="Home" asp-action="BuyingMistakes">@L.T("BuyingMistakes")</a> | <a asp-controller="Home" asp-action="Terms">@L.T("TermsOfUse")</a> | <a asp-controller="Home" asp-action="Privacy">@L.T("PrivacyPolicy")</a></p>
            <p>@L.T("Phone"): <a href="tel:@ContactOptions.Value.Phone">@ContactOptions.Value.Phone</a> | @L.T("WhatsApp"): @ContactOptions.Value.WhatsApp | @L.T("Email"): @ContactOptions.Value.Email</p>
        </div>
    </footer>
    @* شريط المقارنة: يظهر لما تختار إعلانات للمقارنة من الكروت أو التفاصيل. *@
    <div id="compareBar" class="compare-bar" hidden>
        <span id="compareCount"></span>
        <a id="compareLink" class="btn btn-primary" href="#">@L.T("CompareNow")</a>
        <button type="button" id="compareClear" class="btn btn-ghost">@L.T("ClearCompare")</button>
    </div>
    @* مكتبة SignalR من CDN (مطابقة لإصدار .NET 8). لو تعذّر تحميلها،
       يعود site.js تلقائيًا للتحديث الدوري كل 30 ثانية. *@
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.7/dist/browser/signalr.min.js"></script>
    <button type="button" id="backToTop" class="back-to-top" title="@L.T("BackToTop")" aria-label="@L.T("BackToTop")">↑</button>
    <script src="~/js/site.js" defer></script>
</body>
</html>
