@inject Microsoft.AspNetCore.Identity.UserManager<ApplicationUser> HeaderUserManager
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var bodyClass = currentController == "Listings" && currentAction == "Details" ? "page-details" : "";
    var headerUser = User.Identity?.IsAuthenticated == true ? await HeaderUserManager.GetUserAsync(User) : null;
    var displayName = !string.IsNullOrWhiteSpace(headerUser?.FullName) ? headerUser!.FullName : User.Identity?.Name;
}
<!DOCTYPE html>
<html lang="@L.Culture" dir="@(L.IsArabic ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@L.T("Brand") - @L.T("Tagline")</title>
    @await RenderSectionAsync("Meta", required: false)
    <meta name="theme-color" content="#111827" />
    <meta name="description" content="إعلانات عقارات للبيع والإيجار في القاهرة والجيزة — شقق، فيلات، محلات وعمارات." />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    @* الوضع الفاتح/الداكن يُطبَّق قبل رسم الصفحة حتى لا يلمع الداكن أولًا. *@
    <script>try { document.documentElement.setAttribute("data-theme", localStorage.getItem("aqarak-theme") || (function () { var h = new Date().getHours(); return (h >= 6 && h < 18) ? "light" : "dark"; })()); } catch (e) { document.documentElement.setAttribute("data-theme", "dark"); }</script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="@bodyClass">
    <div id="pageLoader" class="page-loader"></div>
    <header class="site-header">
        <div class="container header-inner">
            <a class="brand" asp-controller="Home" asp-action="Index"><span class="brand-icon">🏠</span> @L.T("Brand")</a>
            <nav class="main-nav" id="mainNav">
                <div class="drawer-head">
                    <span class="brand-icon">🏠</span>
                    <div class="drawer-head-text"><strong>@L.T("Brand")</strong><small>@L.T("Tagline")</small></div>
                    <button type="button" class="drawer-close" id="drawerClose" aria-label="إغلاق">✕</button>
                </div>
                <span class="nav-section">الإعلانات</span>
                <a class="nav-link @(currentController == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index">🏠 @L.T("Home")</a>
                <a class="nav-link @(currentController == "Listings" && currentAction == "Index" ? "active" : "")" asp-controller="Listings" asp-action="Index">🏘️ @L.T("Listings")</a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <span class="nav-section">حسابي</span>
                    <div class="drawer-only">
                        <a class="nav-link @(currentController == "Listings" && currentAction == "MyListings" ? "active" : "")" asp-controller="Listings" asp-action="MyListings">📋 @L.T("MyListings")</a>
                        <a class="nav-link @(currentController == "Favorites" ? "active" : "")" asp-controller="Favorites" asp-action="Index">♥ @L.T("Favorites")</a>
                        <a class="nav-link @(currentController == "SavedSearches" ? "active" : "")" asp-controller="SavedSearches" asp-action="Index">🔔 @L.T("SavedSearches")</a>
                        <a class="nav-link @(currentController == "Viewings" ? "active" : "")" asp-controller="Viewings" asp-action="Index">📅 @L.T("Viewings")</a>
                        <a class="nav-link @(currentController == "Account" && currentAction == "MyAccount" ? "active" : "")" asp-controller="Account" asp-action="MyAccount">👤 @L.T("MyAccount")</a>
                    </div>
                    <span class="nav-section">إضافة</span>
                    <a class="nav-cta nav-create-primary @(currentController == "Listings" && currentAction == "Create" ? "active" : "")" asp-controller="Listings" asp-action="Create">➕ @L.T("CreateListing")</a>
                    @* غلاف display:contents حتى تُستبدل الإدارة لحظيًا من غير كسر توزيع الـ flex. *@
                    <span class="nav-section">الإدارة</span>
                    <span id="adminNavLinks" style="display:contents">@await Component.InvokeAsync("AdminNav")</span>
                    @* على الموبايل فقط: تسجيل الخروج داخل اللوحة. *@
                    <div class="panel-account mobile-only">
                        <form asp-controller="Account" asp-action="Logout" method="post" class="inline-form">
                            <button type="submit" class="btn btn-ghost">🚪 @L.T("Logout")</button>
                        </form>
                    </div>
                }
                else
                {
                    <a class="nav-link @(currentController == "Favorites" ? "active" : "")" asp-controller="Favorites" asp-action="Index">♥ @L.T("Favorites")</a>
                    <a class="btn btn-ghost nav-auth" asp-controller="Account" asp-action="Login">🔑 @L.T("Login")</a>
                    <a class="btn btn-primary nav-auth" asp-controller="Account" asp-action="Register">📝 @L.T("Register")</a>
                }
                <span class="nav-section">اللغة</span>
                <a class="nav-link" asp-controller="Language" asp-action="Set" asp-route-lang="@(L.IsArabic ? "en" : "ar")" asp-route-returnUrl="@Context.Request.Path">🌐 @(L.IsArabic ? "English" : "العربية")</a>
            </nav>
            <div class="header-actions">
                <form class="header-search" asp-controller="Listings" asp-action="Index" method="get">
                    <input type="text" name="search" placeholder="ابحث..." aria-label="بحث" />
                </form>
                <button type="button" id="mobileSearchBtn" class="btn btn-ghost header-search-btn" aria-label="بحث">🔍</button>
                <button type="button" id="themeToggle" class="btn btn-ghost" title="الوضع الفاتح / الداكن">☀️</button>
                @await Component.InvokeAsync("NotificationBell")
                @if (User.Identity?.IsAuthenticated == true)
                {
                    @* قائمة الحساب المنسدلة — مكان رابط البروفايل القديم. *@
                    <div class="user-menu">
                        <button type="button" class="nav-link user-menu-btn" id="userMenuBtn">👤 <span class="user-menu-label">@L.T("MyAccount")</span> ▾</button>
                        <div class="user-menu-dropdown" id="userMenuDropdown" hidden>
                            <span class="user-menu-name">👤 @displayName</span>
                            <a class="nav-link @(currentController == "Listings" && currentAction == "MyListings" ? "active" : "")" asp-controller="Listings" asp-action="MyListings">📋 @L.T("MyListings")</a>
                            <a class="nav-link @(currentController == "Favorites" ? "active" : "")" asp-controller="Favorites" asp-action="Index">♥ @L.T("Favorites")</a>
                            <a class="nav-link @(currentController == "SavedSearches" ? "active" : "")" asp-controller="SavedSearches" asp-action="Index">🔔 @L.T("SavedSearches")</a>
                            <a class="nav-link @(currentController == "Viewings" ? "active" : "")" asp-controller="Viewings" asp-action="Index">📅 @L.T("Viewings")</a>
                            <a class="nav-link @(currentController == "Account" && currentAction == "MyAccount" ? "active" : "")" asp-controller="Account" asp-action="MyAccount">👤 @L.T("MyAccount")</a>
                        </div>
                    </div>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="inline-form desktop-only">
                        <button type="submit" class="btn btn-ghost">🚪 @L.T("Logout")</button>
                    </form>
                }
            </div>
            <button type="button" class="nav-toggle" id="navToggle" aria-label="القائمة" aria-expanded="false" aria-controls="mainNav">☰</button>
        </div>
        <form class="header-search-mobile" id="mobileSearchForm" asp-controller="Listings" asp-action="Index" method="get" hidden>
            <input type="text" name="search" placeholder="ابحث عن عقار..." aria-label="بحث" />
            <button type="submit" class="btn btn-primary">بحث</button>
        </form>
    </header>
    <div id="navBackdrop" class="nav-backdrop" hidden></div>
    @* لوحة الإدارة الجانبية: خارج الـ header وقائمة الموبايل عمدًا حتى
       لا يخفيها قفل القائمة (display:none يخفي حتى العناصر fixed). *@
    @if (User.IsInRole("Admin"))
    {
    <span id="adminSidePanel" style="display:contents">@await Component.InvokeAsync("AdminNav", new { panelOnly = true })</span>
    }
    <main class="container main-content">
        @if (TempData["Error"] != null)
        {
            <div class="toast toast-error" role="alert">@TempData["Error"]<button type="button" class="toast-close" aria-label="إغلاق">✕</button></div>
        }
        @if (TempData["Info"] != null)
        {
            <div class="toast toast-info" role="status">@TempData["Info"]<button type="button" class="toast-close" aria-label="إغلاق">✕</button></div>
        }
        @RenderBody()
    </main>
    <footer class="site-footer">
        <div class="container footer-grid">
            <div class="footer-col">
                <p class="footer-brand">@L.T("Brand")</p>
                <p>@L.T("Tagline")</p>
                @await Component.InvokeAsync("FooterStats")
            </div>
            <div class="footer-col">
                <p class="footer-heading">روابط سريعة</p>
                <p>📞 <a asp-controller="Home" asp-action="Contact">@L.T("ContactUs")</a></p>
                <p>📖 <a asp-controller="Home" asp-action="SellGuide">@L.T("SellGuide")</a></p>
                <p>💡 <a asp-controller="Home" asp-action="Tips">@L.T("Tips")</a></p>
                <p>💰 <a asp-controller="Home" asp-action="PriceGuide">@L.T("PriceGuide")</a></p>
                <p>⚠️ <a asp-controller="Home" asp-action="BuyingMistakes">@L.T("BuyingMistakes")</a></p>
                <p>📜 <a asp-controller="Home" asp-action="Terms">@L.T("TermsOfUse")</a></p>
                <p>🔒 <a asp-controller="Home" asp-action="Privacy">@L.T("PrivacyPolicy")</a></p>
                <p>🧮 <a asp-controller="Home" asp-action="Calculator">@L.T("Calculator")</a></p>
                <p>🆕 <a asp-controller="Listings" asp-action="Index" asp-route-sort="newest">أحدث الإعلانات</a></p>
                <p>👁️ <a asp-controller="Listings" asp-action="Index" asp-route-sort="viewsDesc">الأكثر مشاهدة</a></p>
            </div>
            <div class="footer-col">
                <p class="footer-heading">مناطق شائعة</p>
                <p>📍 <a asp-controller="Listings" asp-action="Area" asp-route-area="مدينة نصر">مدينة نصر</a></p>
                <p>📍 <a asp-controller="Listings" asp-action="Area" asp-route-area="المعادي">المعادي</a></p>
                <p>📍 <a asp-controller="Listings" asp-action="Area" asp-route-area="التجمع الخامس">التجمع الخامس</a></p>
                <p>📍 <a asp-controller="Listings" asp-action="Area" asp-route-area="6 أكتوبر">6 أكتوبر</a></p>
                <p>📍 <a asp-controller="Listings" asp-action="Area" asp-route-area="المهندسين">المهندسين</a></p>
            </div>
            <div class="footer-col">
                <p class="footer-heading">تواصل معنا</p>
                <p>@L.T("Phone"): <a href="tel:@ContactOptions.Value.Phone">@ContactOptions.Value.Phone</a></p>
                <p>@L.T("WhatsApp"): @ContactOptions.Value.WhatsApp</p>
                <p>@L.T("Email"): @ContactOptions.Value.Email</p>
                <p>💬 <a href="https://wa.me/@ContactOptions.Value.WhatsAppDigits" target="_blank" rel="noopener">واتساب</a> • 📘 <a href="https://www.facebook.com/sharer/sharer.php?u=@Uri.EscapeDataString($"{Context.Request.Scheme}://{Context.Request.Host}/")" target="_blank" rel="noopener">شارك الموقع على فيسبوك</a></p>
            </div>
        </div>
        <p class="footer-copy">© 2026 @L.T("Brand") — جميع الحقوق محفوظة</p>
    </footer>
    @* Batch 33 (1) — شريط تنقل سفلي في الموبايل. *@
    <nav class="mobile-bottom-nav" aria-label="التنقل السريع">
        <a asp-controller="Home" asp-action="Index" class="@(currentController == "Home" ? "active" : "")"><span class="nav-ico">🏠</span><span>الرئيسية</span></a>
        <a asp-controller="Listings" asp-action="Index" class="@(currentController == "Listings" && (currentAction == "Index" || currentAction == "Area") ? "active" : "")"><span class="nav-ico">🔍</span><span>بحث</span></a>
        <a asp-controller="Listings" asp-action="Create" class="create-link @(currentController == "Listings" && currentAction == "Create" ? "active" : "")"><span class="nav-ico">+</span><span>أضف إعلان</span></a>
        <a asp-controller="Favorites" asp-action="Index" class="@(currentController == "Favorites" ? "active" : "")"><span class="nav-ico">♥</span><span>المفضلة</span></a>
        <a asp-controller="Account" asp-action="MyAccount" class="@(currentController == "Account" && currentAction == "MyAccount" ? "active" : "")"><span class="nav-ico">👤</span><span>حسابي</span></a>
    </nav>
    @if (currentController == "Admin")
    {
        <aside class="admin-sidebar">
            <p class="admin-sidebar-title">لوحة الأدمن</p>
            <a asp-controller="Admin" asp-action="Dashboard">لوحة التحكم</a>
            <a asp-controller="Admin" asp-action="Users">المستخدمون</a>
            <a asp-controller="Admin" asp-action="Listings">الإعلانات</a>
            <a asp-controller="Admin" asp-action="Reports">البلاغات</a>
            <a asp-controller="Admin" asp-action="Requests">طلبات التواصل</a>
            <a asp-controller="Admin" asp-action="Viewings">المعاينات</a>
            <a asp-controller="Admin" asp-action="ContactMessages">رسائل التواصل</a>
            <a asp-controller="Admin" asp-action="BlockedPhones">الأرقام المحظورة</a>
            <a asp-controller="Admin" asp-action="ImportListings">استيراد إعلانات</a>
            <a asp-controller="Admin" asp-action="Notifications">الإشعارات</a>
        </aside>
    }
    @* شريط المقارنة: يظهر لما تختار إعلانات للمقارنة من الكروت أو التفاصيل. *@
    @if (currentController != "Account")
    {
    <div id="compareBar" class="compare-bar" hidden>
        <span id="compareCount"></span>
        <a id="compareLink" class="btn btn-primary" href="#">@L.T("CompareNow")</a>
        <button type="button" id="compareClear" class="btn btn-ghost">@L.T("ClearCompare")</button>
    </div>
    }
    <a class="fab-create" asp-controller="Listings" asp-action="Create" title="@L.T("CreateListing")">＋</a>
    <a class="fab-call" href="tel:@ContactOptions.Value.Phone" aria-label="اتصال">📞</a>
    @* مكتبة SignalR من CDN (مطابقة لإصدار .NET 8). لو تعذّر تحميلها،
       يعود site.js تلقائيًا للتحديث الدوري كل 30 ثانية. *@
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.7/dist/browser/signalr.min.js"></script>
    <button type="button" id="backToTop" class="back-to-top" title="@L.T("BackToTop")" aria-label="@L.T("BackToTop")"><svg viewBox="0 0 36 36" class="back-to-top-ring" aria-hidden="true"><circle cx="18" cy="18" r="16" class="ring-bg" /><circle cx="18" cy="18" r="16" class="ring-fg" /></svg><span class="back-to-top-arrow">↑</span></button>
    @* Batch 33 (3) — ورقة إجراءات الكارت في الموبايل. *@
    <div id="cardSheetBackdrop" class="sheet-backdrop"></div>
    <div id="cardSheet" class="card-sheet" role="dialog" aria-label="خيارات الإعلان">
        <div class="sheet-handle"></div>
        <h3 id="cardSheetTitle"></h3>
        <button type="button" class="sheet-action" id="cardSheetFav">♥ <span>المفضلة</span></button>
        <button type="button" class="sheet-action" id="cardSheetCompare">⚖️ <span>مقارنة</span></button>
        <button type="button" class="sheet-action" id="cardSheetCopy">🔗 <span>نسخ الرابط</span></button>
        <a class="sheet-action" id="cardSheetWhats" target="_blank" rel="noopener">💬 <span>مشاركة واتساب</span></a>
        <a class="sheet-action" id="cardSheetDetails">👁 <span>عرض التفاصيل</span></a>
        <a class="sheet-action" id="cardSheetCall" href="tel:@ContactOptions.Value.Phone">📞 <span>اتصال</span></a>
        <button type="button" class="sheet-action" id="cardSheetClose">✕ <span>إغلاق</span></button>
    </div>
    <script src="~/js/site.js" asp-append-version="true" defer></script>
</body>
</html>
