@model Listing
@inject AqarakOnline.Services.TrustedAdvertiserService TrustedAdvertiser
@{
    var photos = Model.Attachments.Where(a => a.Kind == AttachmentKind.Photo).OrderBy(a => a.Order).ThenBy(a => a.Id).ToList();
    var favoriteIds = ViewBag.FavoriteListingIds as HashSet<int>;
    var isFavorite = favoriteIds != null && favoriteIds.Contains(Model.Id);
    var currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    var isOwner = !string.IsNullOrEmpty(currentUserId) && Model.OwnerId == currentUserId;
    var facts = new List<string>();
    if (Model.Rooms.HasValue) { facts.Add($"🛏️ {L.T("Rooms")}: {Model.Rooms}"); }
    if (Model.Bathrooms.HasValue) { facts.Add($"{L.T("Bathrooms")}: {Model.Bathrooms}"); }
    if (Model.Floor.HasValue) { facts.Add($"🏢 {L.T("Floor")}: {Model.Floor}"); }
    if (Model.Finishing.HasValue) { facts.Add((Model.Finishing.Value switch { FinishingLevel.SuperLux => "✨ ", FinishingLevel.Lux => "💎 ", FinishingLevel.SemiFinished => "🔨 ", FinishingLevel.RedBrick => "🧱 ", _ => "" }) + L.FinishingText(Model.Finishing.Value)); }
if (Model.HasParking) { facts.Add(L.T("Parking")); }
if (Model.HasElevator) { facts.Add(L.T("Elevator")); }
if (Model.HasBalcony) { facts.Add(L.T("Balcony")); }
if (Model.HasAirConditioning) { facts.Add(L.T("AirConditioning")); }
if (Model.HasSecurity) { facts.Add(L.T("Security")); }
if (Model.AcceptsInstallments) { facts.Add(L.T("AcceptsInstallments")); }
if (Model.IsPriceNegotiable) { facts.Add(L.T("Negotiable")); }
if (Model.LandAreaSqm.HasValue) { facts.Add($"{L.T("LandArea")}: {Model.LandAreaSqm}"); }
if (Model.BuildingFloors.HasValue) { facts.Add($"{L.T("BuildingFloors")}: {Model.BuildingFloors}"); }
if (Model.ApartmentsCount.HasValue) { facts.Add($"{L.T("ApartmentsCount")}: {Model.ApartmentsCount}"); }
}
@{
    var typeIcon = Model.PropertyType switch
    {
        PropertyType.Apartment => "🏢",
        PropertyType.House => "🏠",
        PropertyType.Building => "🏗️",
        PropertyType.Shop => "🏪",
        PropertyType.Villa => "🏰",
        _ => ""
    };
    var newAge = DateTime.UtcNow - Model.CreatedAt;
    var newBadgeClass = newAge.TotalHours < 6 ? "badge-new-fresh" : "badge-new-old";
}
<article class="listing-card@(Model.IsEffectivelyFeatured ? " featured-card" : "")@(Model.IsUrgent ? " urgent-card" : "")@(Model.IsAvailable ? " availability-available" : " availability-unavailable")" data-listing-id="@Model.Id" data-listing-type="@Model.ListingType">
    <div class="listing-type-strip listing-type-@Model.ListingType"></div>
    <div class="availability-bar @(Model.IsAvailable ? "available" : "closed")">@(Model.IsAvailable ? L.T("Available") : L.T("NotAvailable"))</div>
    <div class="card-photo-wrap">
    @if (photos.Count > 0)
    {
        <div class="card-photos" data-photo-count="@photos.Count">
            @for (var i = 0; i < photos.Count; i++)
            {
                <img class="listing-photo @(i == 0 ? "active" : "")" src="/@photos[i].FilePath" @Html.Raw(photos[i].ThumbPath != null ? $"srcset=\"/{photos[i].ThumbPath} 480w, /{photos[i].FilePath} 1600w\" sizes=\"(max-width: 640px) 100vw, 400px\"" : "") alt="@Model.Title" loading="lazy" />
            }
        </div>
        @if (photos.Count > 1)
        {
            <button type="button" class="card-photo-nav card-photo-prev" data-dir="-1" aria-label="السابق">‹</button>
            <button type="button" class="card-photo-nav card-photo-next" data-dir="1" aria-label="التالي">›</button>
        }
    }
    else
    {
        <div class="listing-photo placeholder">@L.T("NoPhoto")</div>
    }
        @if (Model.Attachments.Any(a => a.Kind == AttachmentKind.Video))
        {
            <span class="video-badge" title="فيديو">🎬</span>
        }
        <div class="card-photo-actions">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <form asp-controller="Favorites" asp-action="Toggle" method="post" class="inline-form">
                    <input type="hidden" name="listingId" value="@Model.Id" />
                    <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                    <button type="submit" class="btn btn-ghost favorite-btn @(isFavorite ? "is-favorite" : "")" title="@(isFavorite ? "إزالة من المفضلة" : "إضافة إلى المفضلة")" aria-label="@(isFavorite ? "إزالة من المفضلة" : "إضافة إلى المفضلة")">@(isFavorite ? "♥" : "♡")</button>
                </form>
            }
            else
            {
                <button type="button" class="btn btn-ghost favorite-btn guest-favorite" data-id="@Model.Id" title="إضافة إلى المفضلة">♡</button>
            }
            <button type="button" class="btn btn-ghost compare-toggle" data-id="@Model.Id" data-add="⚖️" data-added="✓" data-max="@L.T("CompareMax")" title="@L.T("AddToCompare")">⚖️</button>
            <button type="button" class="btn btn-ghost card-menu-btn" data-id="@Model.Id" title="خيارات" aria-label="خيارات">⋮</button>
        </div>
    </div>
    <div class="listing-body">
        <div class="listing-meta">
            <span class="badge @(Model.ListingType == ListingType.Sale ? "badge-sale" : "badge-rent")">@L.ListingTypeText(Model.ListingType)</span>
            <span class="badge badge-pt-@Model.PropertyType">@typeIcon @L.PropertyTypeText(Model.PropertyType)</span>
            @if (Model.IsEffectivelyFeatured)
            {
                <span class="badge badge-featured">⭐ @L.T("Featured")</span>
            }
            @if (Model.IsUrgent)
            {
                <span class="badge badge-urgent">🔥 @L.T("Urgent")</span>
            }
            @if (Model.IsPriceReduced)
            {
                <span class="badge badge-reduced">🔻 @L.T("PriceReduced")@(Model.OriginalPrice > 0 ? $" {Math.Round((1 - Model.Price / Model.OriginalPrice) * 100)}%" : "")</span>
            }
            @if (await TrustedAdvertiser.IsTrustedAsync(Model.OwnerId))
            {
                <span class="badge badge-trusted">✓ @L.T("TrustedAdvertiser")</span>
            }
            @if (Model.CreatedAt >= DateTime.UtcNow.AddDays(-1))
            {
                <span class="badge badge-new @newBadgeClass">🆕 @L.T("New")</span>
            }
            <span class="ad-number">@L.T("AdNumber"): @Model.AdNumber</span>
        </div>
        <h3><a asp-controller="Listings" asp-action="Details" asp-route-id="@Model.Id" title="@Model.Title">@Model.Title</a></h3>
        <p class="listing-area">📍 @Model.Area • 📐 @Model.AreaSqm م²</p>
        @if (facts.Any())
        {
            <p class="listing-facts">@string.Join(" • ", facts.Take(3))</p>
        }
        <p class="listing-published">📅 @(Model.UpdatedAt.HasValue && Model.UpdatedAt > Model.CreatedAt ? "آخر تحديث " + L.RelativeTime(Model.UpdatedAt.Value) : L.RelativeTime(Model.CreatedAt)) • 👁 @Model.ViewCount</p>
        @if (Model.Approval != ListingApproval.Approved)
        {
            <p class="listing-status">@L.T("ApprovalStatus"): @L.ApprovalText(Model.Approval)</p>
        }
        <div class="card-foot">
            <p class="listing-price">@L.PriceText(Model.Price, Model.ListingType)</p>
            <div class="actions">
            <a class="btn btn-primary view-details-full" asp-controller="Listings" asp-action="Details" asp-route-id="@Model.Id">@L.T("ViewDetails")</a>
            @if (Model.IsAvailable && Model.Approval == ListingApproval.Approved && !isOwner)
            {
                <a class="btn btn-ghost" asp-controller="Contact" asp-action="Contact" asp-route-listingId="@Model.Id">@L.T("ContactUs")</a>
            }
            @if (isOwner)
            {
                <form asp-controller="Listings" asp-action="Bump" method="post" class="inline-form">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                    <button type="submit" class="btn btn-ghost" title="@L.T("RenewListing")">🔄</button>
                </form>
                <form asp-controller="Listings" asp-action="Duplicate" method="post" class="inline-form">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button type="submit" class="btn btn-ghost" title="@L.T("CopyListing")">📋</button>
                </form>
            }
            <button type="button" class="btn btn-ghost share-copy" data-url="@($"{Context.Request.Scheme}://{Context.Request.Host}/Listings/Details/{Model.Id}")" title="@L.T("Share")">↗ @L.T("Share")</button>
            <a class="btn btn-ghost" href="https://t.me/share/url?url=@Uri.EscapeDataString($"{Context.Request.Scheme}://{Context.Request.Host}/Listings/Details/{Model.Id}")&text=@Uri.EscapeDataString(Model.Title)" target="_blank" rel="noopener" title="تيليجرام">✈️</a>
            </div>
        </div>
    </div>
</article>
