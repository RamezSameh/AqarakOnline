@model List<ListingOffer>
<h1>💰 عروضي</h1>
<p>عروض الأسعار اللي قدّمتها — الرد بيوصلك من إدارة الموقع.</p>
@if (!Model.Any())
{
    <p>لم تقدّم أي عرض سعر بعد.</p>
}
else
{
    <div class="saved-searches">
        @foreach (var o in Model)
        {
            <article class="saved-search-card">
                <h3><a asp-controller="Listings" asp-action="Details" asp-route-id="@o.ListingId">@o.Listing?.Title</a></h3>
                <p>سعر الإعلان: @o.Listing?.Price.ToString("N0") جنيه</p>
                <p>عرضك: <strong>@o.Amount.ToString("N0") جنيه</strong></p>
                @if (!string.IsNullOrWhiteSpace(o.Message))
                {
                    <p>رسالتك: @o.Message</p>
                }
                <p>الحالة:
                    @if (o.Status == OfferStatus.Pending)
                    {
                        <strong>بانتظار رد المالك</strong>
                    }
                    else if (o.Status == OfferStatus.Accepted)
                    {
                        <strong>✅ تم القبول — إدارة الموقع هتنسّق معاك</strong>
                    }
                    else if (o.Status == OfferStatus.Declined)
                    {
                        <strong>❌ مرفوض</strong>
                    }
                    else
                    {
                        <strong>↩️ المالك اقترح @o.CounterAmount?.ToString("N0") جنيه</strong>
                    }
                </p>
                @if (o.Status == OfferStatus.Countered)
                {
                    <form asp-action="AcceptCounter" method="post" class="inline-form">
                        <input type="hidden" name="id" value="@o.Id" />
                        <button type="submit" class="btn btn-primary">قبول السعر المقترح (@o.CounterAmount?.ToString("N0") جنيه)</button>
                    </form>
                }
                <p><small>قُدّم في: @o.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</small></p>
            </article>
        }
    </div>
}
