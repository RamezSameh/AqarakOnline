@model AqarakOnline.Controllers.VerifyPhoneViewModel
<h1>@L.T("VerifyPhone")</h1>
<p>أدخل كود التأكيد المكوَّن من 6 أرقام الذي أُرسل إلى رقم الموبايل <strong dir="ltr">@Model.PhoneNumber</strong>. الكود صالح لمدة 10 دقائق.</p>
<form asp-action="VerifyPhone" method="post" class="form">
    <input type="hidden" asp-for="PhoneNumber" />
    <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
    <label>@L.T("VerificationCode")</label>
    <input asp-for="Code" inputmode="numeric" dir="ltr" placeholder="000000" maxlength="6" />
    <span asp-validation-for="Code" class="field-error"></span>
    <div class="actions">
        <button type="submit" class="btn btn-primary">@L.T("Confirm")</button>
    </div>
</form>
<form asp-action="ResendCode" method="post" class="form">
    <input type="hidden" name="phoneNumber" value="@Model.PhoneNumber" />
    <button type="submit" class="btn btn-ghost">@L.T("ResendCode")</button>
</form>
