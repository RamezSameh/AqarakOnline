@model AqarakOnline.Controllers.LoginViewModel
<h1>@L.T("Login")</h1>
<p>الدخول برقم الموبايل الموثَّق.</p>
<form asp-action="Login" method="post" class="form">
    <input type="hidden" asp-for="ReturnUrl" />
    <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
    <label>@L.T("PhoneNumber")</label>
    <input asp-for="PhoneNumber" type="tel" dir="ltr" placeholder="01xxxxxxxxx" />
    <span asp-validation-for="PhoneNumber" class="field-error"></span>
    <label>@L.T("Password")</label>
    <input asp-for="Password" type="password" />
    <span asp-validation-for="Password" class="field-error"></span>
    <label><input asp-for="RememberMe" type="checkbox" /> @L.T("RememberMe")</label>
    <div class="actions">
        <button type="submit" class="btn btn-primary">@L.T("Login")</button>
        <a class="btn btn-ghost" asp-action="Register">@L.T("NoAccount")</a>
    </div>
</form>
