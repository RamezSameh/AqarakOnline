@model AqarakOnline.Controllers.LoginViewModel
<div class="auth-card">
<h1>@L.T("Login")</h1>
<p>الدخول برقم الموبايل (11 رقمًا بالضبط). الحساب الجديد لا يدخل حتى يوافق عليه الأدمن.</p>
<form asp-action="Login" method="post" class="form">
    <input type="hidden" asp-for="ReturnUrl" />
    <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
    <label>@L.T("PhoneNumber")</label>
    <input asp-for="PhoneNumber" type="tel" dir="ltr" placeholder="01xxxxxxxxx" />
    <span asp-validation-for="PhoneNumber" class="field-error"></span>
    <label>@L.T("Password")</label>
    <div class="password-field">
        <input asp-for="Password" type="password" />
        <button type="button" class="btn btn-ghost password-toggle" aria-label="إظهار كلمة المرور">إظهار</button>
    </div>
    <span asp-validation-for="Password" class="field-error"></span>
    <label><input asp-for="RememberMe" type="checkbox" /> @L.T("RememberMe")</label>
    <div class="actions">
        <button type="submit" class="btn btn-primary">@L.T("Login")</button>
        <a class="btn btn-ghost" asp-action="Register">@L.T("NoAccount")</a>
    </div>
</form>
</div>
<div class="auth-card">
<p>حسابك قيد المراجعة وطال الانتظار؟ اطلب مراجعة حسابك:</p>
<form asp-action="RequestReview" method="post" class="form">
    <label>@L.T("PhoneNumber")</label>
    <input type="tel" name="phoneNumber" dir="ltr" placeholder="01xxxxxxxxx" required />
    <div class="actions">
        <button type="submit" class="btn btn-ghost">@L.T("RequestReview")</button>
    </div>
</form>
</div>
