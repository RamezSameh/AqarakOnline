@model AqarakOnline.Controllers.MyAccountViewModel
<h1>@L.T("MyAccount")</h1>
<section class="account-card">
<h2>تفاصيل الحساب</h2>
<div class="details-facts">
    <p><strong>الاسم الكامل</strong> @(Model.FullName ?? "-")</p>
    <p><strong>رقم الهاتف</strong> @(Model.PhoneNumber ?? "-")</p>
    <p><strong>البريد الإلكتروني</strong> @(Model.Email ?? "-")</p>
    <p><strong>العنوان</strong> @(Model.Address ?? "-")</p>
    <p><strong>نوع الحساب</strong> @(Model.IsAdmin ? "أدمن" : "مستخدم")</p>
    <p><strong>حالة الحساب</strong> @(Model.AccountStatus switch { AccountStatus.Pending => "قيد المراجعة", AccountStatus.Active => "نشط", AccountStatus.Suspended => "موقوف مؤقتًا", AccountStatus.Blocked => "محظور", _ => "-" })</p>
    <p><strong>عضو منذ</strong> @L.RelativeTime(Model.MemberSince)</p>
</div>
</section>
<section class="account-card">
<h2>نظرة عامة</h2>
<div class="cards-grid">
    <a class="listing-card stat-card" asp-controller="Listings" asp-action="MyListings"><div class="listing-body"><h3>📋 إعلاناتي</h3><p class="stat-number">@Model.MyListingsCount</p><p>مقبول: @Model.ApprovedListingsCount | معلّق: @Model.PendingListingsCount</p></div></a>
    <a class="listing-card stat-card" asp-controller="SavedSearches" asp-action="Index"><div class="listing-body"><h3>🔍 بحثي المحفوظ</h3><p class="stat-number">@Model.SavedSearchesCount</p></div></a>
    <a class="listing-card stat-card" asp-controller="Viewings" asp-action="Index"><div class="listing-body"><h3>📅 مواعيد المعاينة</h3><p class="stat-number">@Model.ActiveViewingsCount</p></div></a>
    <a class="listing-card stat-card" asp-controller="Notifications" asp-action="Index"><div class="listing-body"><h3>🔔 تنبيهات غير مقروءة</h3><p class="stat-number">@Model.UnreadNotificationsCount</p></div></a>
</div>
</section>
<section class="account-card">
<h2>نشاطي</h2>
<p>آخر نشاط: @(Model.LastActivityAt.HasValue ? L.RelativeTime(Model.LastActivityAt.Value) : "-")</p>
</section>
@if (ViewBag.TopViewedListings is System.Collections.Generic.IEnumerable<dynamic> topViewed && topViewed.Any())
{
<section class="account-card">
    <h2>مشاهدات إعلاناتي</h2>
    <div class="chart">
        @foreach (var item in topViewed)
        {
            var maxViews = topViewed.Max(x => (int)x.ViewCount);
            var width = maxViews > 0 ? (int)((double)item.ViewCount / maxViews * 100) : 0;
            <div class="chart-row"><span class="chart-label">@item.Title</span><div class="chart-track"><div class="chart-bar" style="width:@width%"></div></div><span class="chart-value">@item.ViewCount</span></div>
        }
    </div>
</section>
}
<section class="account-card">
<h2>أقسام حسابي</h2>
<div class="account-menu">
    <a class="account-menu-item" asp-controller="PropertyRequests" asp-action="Index"><span>📋 طلبات عقار</span><span class="account-menu-chev">‹</span></a>
    <a class="account-menu-item" asp-controller="PropertyRequests" asp-action="MyRequests"><span>📝 طلباتي</span><span class="account-menu-chev">‹</span></a>
    <a class="account-menu-item" asp-controller="Offers" asp-action="MyOffers"><span>💰 عروضي</span><span class="account-menu-chev">‹</span></a>
    <a class="account-menu-item" asp-controller="Offers" asp-action="ReceivedOffers"><span>💰 العروض الواردة</span><span class="account-menu-chev">‹</span></a>
</div>
</section>
<section class="account-card">
<h2>💬 تنبيهات واتساب</h2>
<p>لما ينزل إعلان جديد مطابق لبحثك المحفوظ أو طلبك، توصلك رسالة واتساب على رقمك المسجّل — بجانب جرس التنبيهات جوه الموقع.</p>
<form asp-action="SetWhatsAppAlerts" method="post" class="form">
    <label>
        <input type="checkbox" name="receiveWhatsAppAlerts" value="true" checked="@Model.ReceiveWhatsAppAlerts" /> تفعيل تنبيهات واتساب
    </label>
    <button type="submit" class="btn btn-primary">حفظ</button>
</form>
</section>
<section class="account-card">
<h2>أحدث التنبيهات</h2>
@if (!Model.RecentNotifications.Any())
{
    <p>لا توجد تنبيهات بعد.</p>
}
else
{
    <ul class="account-notifications">
        @foreach (var notification in Model.RecentNotifications)
        {
            <li>
                <strong>@notification.Title</strong> — @notification.Message
                <span>(@L.RelativeTime(notification.CreatedAt))</span>
            </li>
        }
    </ul>
}
</section>
