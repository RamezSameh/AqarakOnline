@model AqarakOnline.Controllers.MyAccountViewModel
<h1>@L.T("MyAccount")</h1>
<section class="account-card">
<h2>نظرة عامة</h2>
<div class="cards-grid">
    <div class="listing-card stat-card"><div class="listing-body"><h3>إعلاناتي</h3><p class="stat-number">@Model.MyListingsCount</p><p>مقبول: @Model.ApprovedListingsCount | معلّق: @Model.PendingListingsCount</p></div></div>
    <div class="listing-card stat-card"><div class="listing-body"><h3>المفضلة</h3><p class="stat-number">@Model.FavoritesCount</p></div></div>
    <div class="listing-card stat-card"><div class="listing-body"><h3>بحثي المحفوظ</h3><p class="stat-number">@Model.SavedSearchesCount</p></div></div>
    <div class="listing-card stat-card"><div class="listing-body"><h3>تنبيهات غير مقروءة</h3><p class="stat-number">@Model.UnreadNotificationsCount</p></div></div>
</div>
</section>
<section class="account-card">
<h2>نشاطي</h2>
<p>آخر نشاط: @(Model.LastActivityAt.HasValue ? L.RelativeTime(Model.LastActivityAt.Value) : "-")</p>
@if (ViewBag.TopViewedListings is System.Collections.Generic.IEnumerable<dynamic> topViewed && topViewed.Any())
{
    <h2>مشاهدات إعلاناتي</h2>
    <div class="chart">
        @foreach (var item in topViewed)
        {
            var maxViews = topViewed.Max(x => (int)x.ViewCount);
            var width = maxViews > 0 ? (int)((double)item.ViewCount / maxViews * 100) : 0;
            <div class="chart-row"><span class="chart-label">@item.Title</span><div class="chart-track"><div class="chart-bar" style="width:@width%"></div></div><span class="chart-value">@item.ViewCount</span></div>
        }
    </div>
}
</section>
<section class="account-card">
<h2>روابط سريعة</h2>
<div class="quick-links">
    <a class="btn btn-ghost quick-link" asp-controller="Listings" asp-action="MyListings">📋 إعلاناتي</a>
    <a class="btn btn-ghost quick-link" asp-controller="Favorites" asp-action="Index">♥ المفضلة</a>
    <a class="btn btn-ghost quick-link" asp-controller="SavedSearches" asp-action="Index">🔍 بحثي المحفوظ</a>
    <a class="btn btn-ghost quick-link" asp-controller="Notifications" asp-action="Index">🔔 التنبيهات</a>
</div>
</section>
<section class="account-card">
<h2>أحدث التنبيهات</h2>
@if (!Model.RecentNotifications.Any())
{
    <p>لا توجد تنبيهات بعد.</p>
}
else
{
    <ul>
        @foreach (var notification in Model.RecentNotifications)
        {
            <li>
                <strong>@notification.Title</strong> — @notification.Message
                <span>(@L.RelativeTime(notification.CreatedAt))</span>
            </li>
        }
    </ul>
}
</section>
