@model AqarakOnline.Controllers.RegisterViewModel
<h1>@L.T("Register")</h1>
<p>التسجيل يتطلب الاسم والعنوان ورقم موبايل مكوّن من 11 رقمًا بالضبط. بعد التسجيل، سيتم تفعيل حسابك بعد موافقة الأدمن.</p>
<form asp-action="Register" method="post" class="form">
    <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
    <label>@L.T("FullName")</label>
    <input asp-for="FullName" />
    <span asp-validation-for="FullName" class="field-error"></span>
    <label>@L.T("Address")</label>
    <input asp-for="Address" />
    <span asp-validation-for="Address" class="field-error"></span>
    <label>@L.T("PhoneNumber")</label>
    <input asp-for="PhoneNumber" type="tel" dir="ltr" placeholder="01xxxxxxxxx" />
    <span asp-validation-for="PhoneNumber" class="field-error"></span>
    <label>@L.T("Email") (اختياري)</label>
    <input asp-for="Email" type="email" />
    <span asp-validation-for="Email" class="field-error"></span>
    <label>@L.T("Password")</label>
    <div class="password-field">
        <input asp-for="Password" type="password" />
        <button type="button" class="btn btn-ghost password-toggle" aria-label="إظهار كلمة المرور">إظهار</button>
    </div>
    <span asp-validation-for="Password" class="field-error"></span>
    <label>@L.T("ConfirmPassword")</label>
    <div class="password-field">
        <input asp-for="ConfirmPassword" type="password" />
        <button type="button" class="btn btn-ghost password-toggle" aria-label="إظهار كلمة المرور">إظهار</button>
    </div>
    <span asp-validation-for="ConfirmPassword" class="field-error"></span>
    <div class="actions">
        <button type="submit" class="btn btn-primary">@L.T("Register")</button>
        <a class="btn btn-ghost" asp-action="Login">@L.T("HasAccount")</a>
    </div>
</form>
