<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <security>
        <requestFiltering>
          <!-- Batch 64 — الفيديو يُقبل بأي حجم: حد محتوى الطلب 2 جيجا بدل 28 ميجا الافتراضية -->
          <requestLimits maxAllowedContentLength="2147483647" />
        </requestFiltering>
      </security>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <!-- requestTimeout 20 دقيقة: رفع + ضغط فيديو كبير ياخد وقت، والافتراضي دقيقتان -->
      <aspNetCore processPath="dotnet" arguments=".\AqarakOnline.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" requestTimeout="00:20:00" />
    </system.webServer>
  </location>
</configuration>
